<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Mullion.App.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SurfaceColor">#12151A</Color>
          <Color x:Key="PanelColor">#1A1E25</Color>
          <SolidColorBrush x:Key="Surface" Color="#12151A" />
          <SolidColorBrush x:Key="Panel" Color="#1A1E25" />
          <SolidColorBrush x:Key="PanelBorder" Color="#333A45" />
          <SolidColorBrush x:Key="Accent" Color="#4C8BF5" />
          <SolidColorBrush x:Key="AccentSoft" Color="#204C8BF5" />
          <SolidColorBrush x:Key="AccentFaint" Color="#0F4C8BF5" />
          <SolidColorBrush x:Key="AccentMid" Color="#3D4C8BF5" />
          <SolidColorBrush x:Key="Ink" Color="#E8ECF3" />
          <SolidColorBrush x:Key="InkDim" Color="#98A2B3" />
          <SolidColorBrush x:Key="InkFaint" Color="#5D6675" />
          <SolidColorBrush x:Key="ChipBack" Color="#2A303B" />
          <SolidColorBrush x:Key="Taskbar" Color="#0C0E12" />
          <SolidColorBrush x:Key="SpanTint" Color="#28D9A441" />
          <SolidColorBrush x:Key="SpanBorder" Color="#D9A441" />
          <SolidColorBrush x:Key="CaptureTint" Color="#3833D17A" />
          <SolidColorBrush x:Key="CaptureBorder" Color="#33D17A" />
          <LinearGradientBrush x:Key="BezelFill" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#1E232B" />
            <GradientStop Offset="1" Color="#161A21" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <Color x:Key="SurfaceColor">#F4F6FA</Color>
          <Color x:Key="PanelColor">#FFFFFF</Color>
          <SolidColorBrush x:Key="Surface" Color="#F4F6FA" />
          <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PanelBorder" Color="#CFD6E0" />
          <SolidColorBrush x:Key="Accent" Color="#2563EB" />
          <SolidColorBrush x:Key="AccentSoft" Color="#1F2563EB" />
          <SolidColorBrush x:Key="AccentFaint" Color="#0F2563EB" />
          <SolidColorBrush x:Key="AccentMid" Color="#3A2563EB" />
          <SolidColorBrush x:Key="Ink" Color="#131720" />
          <SolidColorBrush x:Key="InkDim" Color="#5A6472" />
          <SolidColorBrush x:Key="InkFaint" Color="#93A0B2" />
          <SolidColorBrush x:Key="ChipBack" Color="#E4E9F1" />
          <SolidColorBrush x:Key="Taskbar" Color="#DDE3EC" />
          <SolidColorBrush x:Key="SpanTint" Color="#2FB4801F" />
          <SolidColorBrush x:Key="SpanBorder" Color="#B4801F" />
          <SolidColorBrush x:Key="CaptureTint" Color="#3A1E8E4A" />
          <SolidColorBrush x:Key="CaptureBorder" Color="#1E8E4A" />
          <LinearGradientBrush x:Key="BezelFill" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#EEF1F6" />
          </LinearGradientBrush>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Monitor panel. The top-left corner is square so the name tab sitting in
       it meets straight edges: against a rounded corner the bezel curves away
       under the tab and the two read as separate objects. -->
  <Style Selector="Border.monitorBezel">
    <Setter Property="CornerRadius" Value="0,10,10,10" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="Background" Value="{DynamicResource BezelFill}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 6 20 0 #33000000" />
  </Style>

  <Style Selector="Border.taskbarStrip">
    <Setter Property="Background" Value="{DynamicResource Taskbar}" />
  </Style>

  <!-- Zone tiles. Templated flat so a Button reads as a zone, not a control. -->
  <Style Selector="Button.zoneTileButton">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Arrow" />

    <!-- All four are load-bearing for a to-scale diagram.
         Alignment: unless it is Stretch, Avalonia's ArrangeCore clamps the
         control to its DesiredSize instead of filling the rect the panel gave
         it, so every tile ends up content-sized and the 25/50/25 split stops
         looking like 25/50/25. Border defaults to Stretch; Button does not.
         MinWidth/MinHeight: Fluent gives Button non-zero defaults, and Arrange
         will not shrink below them, which inflates the narrow zones. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="tile"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <!-- A union drawn as a dimension line rather than a panel: end caps, a rule
       between them, and the label interrupting it. A filled rectangle here read
       as another monitor on the desk, which is the one thing it is not. -->
  <Style Selector="Button.spanMeasure">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />

    <!-- Stretch is load-bearing: without it Arrange clamps to DesiredSize and
         the measure stops lining up with the monitors it is measuring. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.spanMeasure Rectangle.measureRule">
    <Setter Property="Fill" Value="{DynamicResource InkFaint}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>


  <Style Selector="Button.spanMeasure Rectangle.measureCap">
    <Setter Property="Fill" Value="{DynamicResource InkFaint}" />
    <Setter Property="RadiusX" Value="1" />
    <Setter Property="RadiusY" Value="1" />
  </Style>


  <Style Selector="Button.spanMeasure.interactive">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.spanMeasure.interactive:pointerover Rectangle.measureRule">
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Button.spanMeasure.interactive:pointerover Rectangle.measureCap">
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Button.spanMeasure.capturing Rectangle.measureRule">
    <Setter Property="Fill" Value="{DynamicResource CaptureBorder}" />
  </Style>

  <Style Selector="Button.spanMeasure.capturing Rectangle.measureCap">
    <Setter Property="Fill" Value="{DynamicResource CaptureBorder}" />
  </Style>
  <!-- Nothing in the diagram flinches when it is pressed.

       Fluent shrinks a pressed Button to 0.98, which is good feedback on a
       control and wrong here twice over. On a diagram drawn to scale it is a
       lie: the one thing every tile is claiming is that its size means
       something. And outside edit mode there is no command behind the tile at
       all, so the flinch was the whole of what a click did - a zone that looked
       like it was doing something and was not.

       The states that mean something say so in color instead: accent while
       pointed at, green while waiting for a key. -->
  <Style Selector="Button.zoneTileButton:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="Button.subZoneRegion:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="Button.spanMeasure:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Only an interactive diagram invites clicking -->
  <Style Selector="Button.zoneTileButton.interactive">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- No fill change on hover. This washed the whole tile whenever the pointer
       was anywhere inside it - including over one of its halves, so the half
       lit up and the tile lit up harder, and the stronger signal was the wrong
       one. The outline says what is being pointed at; a fill that strong just
       buries the chips and sizes being read to decide. -->

  <!-- A zone crossing a physical bezel is unusual enough to look different -->
  <Style Selector="Button.zoneTileButton.spanning">
    <Setter Property="Background" Value="{DynamicResource SpanTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SpanBorder}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Awaiting a keypress: unmistakable, since the next key goes here -->
  <Style Selector="Button.zoneTileButton.capturing">
    <Setter Property="Background" Value="{DynamicResource CaptureTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CaptureBorder}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>

  <!-- A region inside a zone, not a zone of its own: dashed and faded so the
       hierarchy reads at a glance. Border has no dash support in Avalonia,
       hence a Rectangle. -->
  <Style Selector="Rectangle.subZone">
    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="3,3" />
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="RadiusX" Value="4" />
    <Setter Property="RadiusY" Value="4" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Margin" Value="2" />
  </Style>

  <Style Selector="Border.keyChip">
    <Setter Property="Background" Value="{DynamicResource ChipBack}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <!-- Descendant selectors, not child ones: a chip's runs sit inside a panel
       that changes with how the chord is laid out, and a selector naming that
       panel silently stops matching the moment it does. -->
  <Style Selector="Border.keyChip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.keyChip.primaryChip TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Border.keyChip.tierChip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
  </Style>

  <!-- Dimmer than the key but the SAME size. It was smaller, which read well on
       one line and badly the moment a long chord wrapped: stacked, two type
       sizes in one chip look like a mistake rather than a hierarchy. Opacity
       alone still says "this part is context, the letter is the answer".
       Last, so it wins over the chip variants above without restating them. -->
  <Style Selector="Border.keyChip TextBlock.chipModifier">
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="0" />

    <!-- The key chips letter-space their text, which after a "+" reads as a
         space between the modifier and the key rather than as tracking. -->
    <Setter Property="LetterSpacing" Value="0" />
  </Style>

  <!-- The home-row key reads as the column's main target -->

  <Style Selector="Border.keyChip.primaryChip">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <Style Selector="Border.keyChip.primaryChip > TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- The chip on a span measure stands taller than a zone chip: it has to read
       as centered on the label block - the text and the rule beneath it - rather
       than on the rule alone, so it reaches up behind the text. The lift is a
       RenderTransform so the row it sits in stays centered on the rule. -->
  <Style Selector="Border.keyChip.spanChip">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="RenderTransform">
      <TranslateTransform Y="-6" />
    </Setter>
  </Style>

  <!-- Tier keys are secondary: same column, half the height -->
  <Style Selector="Border.keyChip.tierChip">
    <Setter Property="Padding" Value="7,1" />
  </Style>

  <Style Selector="Border.keyChip.tierChip > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
  </Style>

  <!-- Thumbnail chips.

       A zone in a wizard card is about fifty pixels tall and has to hold three
       of these stacked - the column's key with its two halves above and below -
       so at full size they simply sat on top of one another and none of the
       three could be read. Everything else compact mode meets it drops; these
       it cannot, because the keys are the whole of what the card is choosing
       between.

       After the base chip styles rather than merged into them: Avalonia settles
       selectors of equal weight by declaration order, so these have to come
       last to win. -->
  <Style Selector="ctl|MonitorDiagram.compact Border.keyChip">
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ctl|MonitorDiagram.compact Border.keyChip TextBlock">
    <Setter Property="FontSize" Value="9" />
  </Style>

  <!-- Still the largest thing in its column, because that is what it means. -->
  <Style Selector="ctl|MonitorDiagram.compact Border.keyChip.primaryChip">
    <Setter Property="Padding" Value="6,1" />
  </Style>

  <Style Selector="ctl|MonitorDiagram.compact Border.keyChip.primaryChip TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="ctl|MonitorDiagram.compact Border.keyChip.tierChip">
    <Setter Property="Padding" Value="4,0" />
  </Style>

  <Style Selector="ctl|MonitorDiagram.compact Border.keyChip.tierChip TextBlock">
    <Setter Property="FontSize" Value="9" />
  </Style>

  <!-- The outline round the zone's key is chrome, and on a thumbnail it costs
       more than what it frames: ten pixels of border and padding around a chip
       that has about fourteen to live in, all of it taken from the band between
       the tier chips. It exists to say "this is a thing you can point at", and
       a wizard card is not hit-testable at all.

       Declared here rather than beside the base style so it wins on order. -->
  <Style Selector="ctl|MonitorDiagram.compact Border.wholeZoneBlock">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TextBlock.zoneName">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
  </Style>

  <Style Selector="TextBlock.zoneSize">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
  </Style>

  <!-- A tab attached to the top-left of its monitor: rounded on top, square
       along the bottom where it meets the bezel, sharing the bezel's fill and
       border so the two read as one object. Fixed height so the negative margin
       that lifts it can land its bottom edge exactly on the bezel's top. -->
  <!-- Two lines, not one. Side by side the name and the resolution made a tab
       far wider than a portrait monitor, and on a row of them each tab ran under
       its neighbor and was cut off mid-word. Stacked, the tab is only as wide
       as its longer line, which fits above the monitor it belongs to. -->
  <Style Selector="Border.monitorLabel">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="MaxHeight" Value="46" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="0,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource ChipBack}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
  </Style>

  <Style Selector="Border.monitorLabel > StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.monitorTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.monitorDetail">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
    <Setter Property="Margin" Value="0,-2,0,0" />
  </Style>

  <!-- Page furniture -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- A section of a card that folds away.

       Stripped back to a heading with a chevron. Fluent's Expander brings a
       background, a border, a corner radius and a touch-sized header of its
       own, and inside a card that reads as a second card sitting in the first -
       a box in a box, for something that is not a separate thing at all but one
       of the card's own sections.

       Done with the theme's own resources rather than by setting Background on
       the header. The header's fill does not come from the ToggleButton's
       Background property at all, so overriding that changed nothing and the
       pointer still painted a black slab across the heading. These are the keys
       the template actually reads. -->
  <Style Selector="Expander.cardSection">
    <Style.Resources>
      <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />

      <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="Transparent" />

      <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />

      <!-- The header is one line of text standing where a card's heading
           stands, so it takes a heading's room and no more. Fluent sizes it for
           a touch target, which left the collapsed card twice as tall as the
           line in it. -->
      <Thickness x:Key="ExpanderHeaderPadding">0</Thickness>
      <Thickness x:Key="ExpanderContentPadding">0</Thickness>
      <x:Double x:Key="ExpanderMinHeight">0</x:Double>
    </Style.Resources>

    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />

    <!-- Across the card, not around the word. Sized to its content the header
         was as wide as "Hotkeys" while it was shut and as wide as the key list
         once it was open, so the chevron jumped from beside the heading to the
         far edge on the way. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Expander.cardSection /template/ ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- The header is a bare string, so it arrives as a TextBlock the theme
       would otherwise leave at body weight. -->
  <Style Selector="Expander.cardSection /template/ ToggleButton TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- Layout choice cards -->
  <Style Selector="RadioButton.choiceCard">
    <Setter Property="Padding" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.choiceCard:checked">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="RadioButton.choiceCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Border.previewFrame">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- A square, quiet icon button. No border or fill until hovered, so it sits
       beside labeled buttons without competing with them. -->
  <!-- Icon buttons
       No chrome at all: the icon IS the button. A backing plate behind every one
       of them made the row read as a strip of tiles rather than as a set of
       actions, and gave "pressable" two competing signals - the plate and the
       icon's own brightness. One signal is clearer, so brightness carries it:
       dim at rest, bright under the pointer, faint when there is nothing to
       press, accent while a toggle is holding its state on.

       Meaning is left to the shape and the tooltip, never to a color one button
       has and its neighbor does not. -->
  <!-- An icon standing beside a line of prose rather than inside a button, so it
       takes the same brush the prose does and is not mistaken for something
       clickable. Stretch=None for the reason every icon here uses it: each glyph
       keeps the proportions it was drawn with. -->
  <Style Selector="Path.noteIcon">
    <Setter Property="Fill" Value="{DynamicResource InkDim}" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
  </Style>

  <!-- A word about the hotkeys beside the pause button, and only when there is
       something wrong. Amber rather than red: the hook coming back is a fact
       worth knowing, not a failure to act on. -->
  <Style Selector="TextBlock.hookWarning">
    <Setter Property="Foreground" Value="{DynamicResource SpanBorder}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- A new release, beside the version it would replace. Written as text
       rather than drawn as a button because it is news, not a control the
       window is built around - but it IS clickable, so it takes the hand
       cursor and lifts on hover. The inert rule covers things that only look
       interactive; this one genuinely is. Amber, like the hook notice, for the
       same reason: worth knowing, not urgent. -->
  <Style Selector="Button.updateLink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SpanBorder}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.updateLink /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.updateLink:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="Button.updateLink:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.iconButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Stretch=None so each icon keeps the size it was drawn at. Uniform scales
       every glyph to fill the box, which made a square cross visibly bigger than
       a short, wide tick in the same 18px. -->
  <Style Selector="Button.iconButton > Path">
    <Setter Property="Fill" Value="{DynamicResource InkDim}" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
  </Style>

  <Style Selector="Button.iconButton /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.iconButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.iconButton:pointerover > Path">
    <Setter Property="Fill" Value="{DynamicResource Ink}" />
  </Style>

  <!-- Faint rather than hidden: a row that loses buttons at its limits shifts
       the remaining ones under the cursor. -->
  <Style Selector="Button.iconButton:disabled > Path">
    <Setter Property="Fill" Value="{DynamicResource InkFaint}" />
  </Style>

  <Style Selector="Button.iconButton:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Holding something on, which is a different thing from being hovered. -->
  <Style Selector="Button.iconButton.active > Path">
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>

  <!-- The heart at the top of the ask. Larger than a toolbar icon and in the
       accent, because it is the only decoration in the window and the thing
       that says at a glance what the window is for. -->
  <Style Selector="Path.sponsorMark">
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
  </Style>

  <!-- An amount, as a chip rather than a radio button. The choice is between
       four numbers and a text box; radio circles would add a column of
       furniture to a row that reads perfectly well as buttons, one of which is
       pressed. -->
  <Style Selector="Button.amountChip">
    <Setter Property="Background" Value="{DynamicResource ChipBack}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.amountChip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChipBack}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentMid}" />
  </Style>

  <!-- Declared after the hover rule so a chosen chip stays chosen while the
       pointer is over it. -->
  <Style Selector="Button.amountChip.chosen /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.amountChip.chosen">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Nothing in this window flinches when pressed; the chips report by
       staying lit, which is the state that matters. -->
  <Style Selector="Button.amountChip:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,6" />
  </Style>

  <!-- Distinct from a warning: nothing is wrong, but everything shown is
       fictional and must not be mistaken for the real machine. -->
  <Style Selector="Border.simulation">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.warning">
    <Setter Property="Background" Value="{DynamicResource SpanTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SpanBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>


  <!-- Split seams
       Nearly invisible until pointed at. A diagram with a bar drawn between
       every pair of zones reads as a layout made of bars, and the seams are
       incidental to what it is showing: they are how you change the picture,
       not part of it. Hover is what says a seam is there to be grabbed, and the
       cursor says which way it moves. -->
  <Style Selector="ctl|SplitHandle.seam">
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Transparent, not unset: a null background is not hit-testable, so
             the handle would be a control nothing can grab. -->
        <Border Background="Transparent">
          <Border Name="Grip" Background="{DynamicResource InkFaint}"
                  Opacity="0" CornerRadius="2"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Width="3" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ctl|SplitHandle.seam[Orientation=Horizontal]">
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>

  <!-- A seam on a stacked split runs across the display, so its grip lies flat
       and the cursor points the other way. -->
  <Style Selector="ctl|SplitHandle.seam[Orientation=Vertical]">
    <Setter Property="Cursor" Value="SizeNorthSouth" />
  </Style>

  <Style Selector="ctl|SplitHandle.seam[Orientation=Vertical] /template/ Border#Grip">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="3" />
  </Style>

  <Style Selector="ctl|SplitHandle.seam:pointerover /template/ Border#Grip">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="ctl|SplitHandle.seam /template/ Border#Grip">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Zone stepper
       Same tab treatment as the monitor's name, so the two read as a pair of
       tags on the display rather than as a control that has landed on it. -->
  <Style Selector="Border.zoneStepper">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="Padding" Value="4,2" />
  </Style>

  <Style Selector="Border.zoneStepper Button.stepperButton">
    <Setter Property="Background" Value="{DynamicResource ChipBack}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="18" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.zoneStepper Button.stepperButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Disabled at a bound rather than hidden: a stepper that loses a button at
       the limit shifts the other one under the cursor. -->
  <Style Selector="Border.zoneStepper Button.stepperButton:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Turn a zone.s subzones through a right angle. Quiet at rest and only
       ever present while editing, so it never competes with the chips it shares
       a tile with; it is a control on a picture, and the picture is the point. -->
  <!-- A chord that is also the control for changing it. The thing you want to
       change is the thing you click, which beats a button beside it labelled
       "change". Monospaced so a row of them lines up down the column. -->
  <Style Selector="Button.chordButton">
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.chordButton.capturing">
    <Setter Property="Foreground" Value="{DynamicResource CaptureBorder}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CaptureBorder}" />
  </Style>

  <Style Selector="Button.zoneFlipButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.zoneFlipButton /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Fluent shrinks a pressed button, which on a control this size reads as a
       flinch rather than as feedback. The color change is the feedback. -->
  <Style Selector="Button.zoneFlipButton:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- No plate behind it on hover. A filled square appearing under a mark this
       small is a bigger change than the mark itself, and it lands right where
       the zone.s own dashed outline runs. The arrow brightening to the accent is
       the whole feedback, and it is the arrow that is being pointed at. -->
  <!-- Sized to the whole 24x24 the icon is drawn in, not to the ink in it.
       A Path measures its geometry's bounds, and this arrow's bounds are wider
       than they are tall - so the box's centre and the arrow's centre are not the
       same point, and rotating about the box moved the arrow. Claiming the full
       square makes the two coincide, which is what lets the upright form sit
       exactly where the flat one did. -->
  <Style Selector="Path.zoneFlipMark">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Fill" Value="{DynamicResource InkFaint}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.09" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.zoneFlipButton:pointerover Path.zoneFlipMark">
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Already split side by side, so the offer is to stand the arrow up. Avalonia
       takes RenderTransformOrigin from the middle by default, which is the whole
       reason this is a rotation and not a second icon: the centre cannot move. -->
  <Style Selector="Button.zoneFlipButton.upright Viewbox">
    <Setter Property="RenderTransform">
      <RotateTransform Angle="90" />
    </Setter>
  </Style>

  <Style Selector="Border.zoneStepper TextBlock.stepperCount">
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinWidth" Value="14" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A message from the editor: an outcome, or what it is waiting for. Given a
       surface of its own so a sentence can be read rather than trimmed. -->
  <!-- Everything the zone editor says, in one voice.

       There were two: a tinted card above the diagram for instructions, and
       bare accent text in the toolbar for confirmations. Two looks for two
       things that are the same thing - the editor talking - and the card is the
       better of them, so the card won and moved inline.

       Padding is set against the toolbar's icon buttons: 30px tall, and this
       has to fit inside that or it starts pushing again. Text plus 4 top and
       bottom plus the border comes to about 25. -->
  <Style Selector="Border.editorNotice">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentMid}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,4" />
  </Style>

  <!-- The wrapper that makes the transient one dismissable. Nothing of the
       button shows: the notice inside it is the whole appearance. -->
  <Style Selector="Button.editorNoticeButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.editorNoticeButton /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.editorNoticeButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.editorNoticeButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Fluent shrinks a pressed button, which on a notice that is about to
       vanish reads as a glitch rather than as feedback. -->
  <Style Selector="Button.editorNoticeButton:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="Button.editorNoticeButton:pointerover Border.editorNotice">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- A tier chip is its own target
       The tile means "the whole of this column"; a tier chip means the half it
       is drawn in. Making the chip a button is the difference between the
       diagram being one big click target and being the thing you actually point
       at. Templated to nothing so it stays a chip to look at. -->

  <!-- Sub-zone regions
       The half of a column, drawn as it really is and clickable as what it is.
       Templated rather than styled directly so the dashed outline and the hover
       fill are the same control: what lights up under the pointer is exactly
       what a click will change. -->
  <Style Selector="Button.subZoneRegion">
    <!-- Stretch explicitly. A templated button with no content has nothing to
         size to, and these came out 5px square - present, hit-testable, and
         far too small ever to be pointed at. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Rectangle Classes="subZone" />
          <Border Name="Glow" Opacity="0" CornerRadius="3"
                  Background="{DynamicResource AccentFaint}"
                  BorderBrush="{DynamicResource Accent}"
                  BorderThickness="2" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.subZoneRegion.interactive">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.subZoneRegion.interactive:pointerover /template/ Border#Glow">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Still lit while it waits for a key, so the zone being rebound stays
       obvious after the pointer has moved away to the keyboard. -->
  <Style Selector="Button.subZoneRegion.capturing /template/ Border#Glow">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Background" Value="{DynamicResource CaptureTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CaptureBorder}" />
  </Style>

  <Style Selector="Button.subZoneRegion /template/ Border#Glow">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.09" />
      </Transitions>
    </Setter>
  </Style>

  <!-- The whole column, lit the same way so the two read as one idea at two
       scales rather than as two different kinds of highlight. -->
  <Style Selector="Border.zoneHighlight">
    <Setter Property="Background" Value="{DynamicResource AccentFaint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- The whole zone, as its own block
       The chip, the name and the size together ARE the zone: an outline round
       them says so, and says they can be pointed at, which was the one thing
       the tile did not show. Quiet at rest - it is inside a zone that already
       has a border of its own, and two boxes of equal weight read as two zones. -->
  <Style Selector="Border.wholeZoneBlock">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Picked up by the pointer, and by the outline the tile draws round itself
       at the same moment: the block is the handle, the tile is what it moves. -->
  <Style Selector="Button.zoneTileButton.interactive Border.wholeZoneBlock">
    <Setter Property="BorderBrush" Value="{DynamicResource InkFaint}" />
  </Style>

  <Style Selector="Border.wholeZoneBlock">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.09" />
      </Transitions>
    </Setter>
  </Style>
  <!-- Waiting for a key
       The chip goes green with the region around it. It was left accent-blue,
       which is its ordinary color, so picking a whole zone looked like nothing
       had happened - while picking one of its halves turned that chip green.
       One color means "this is the one you are binding", wherever it appears.

       Declared late on purpose: styles of equal weight are settled by order,
       and the plain chip style comes after this one in the file. -->
  <Style Selector="Button.zoneTileButton.capturing Border.keyChip.primaryChip">
    <Setter Property="Background" Value="{DynamicResource CaptureBorder}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CaptureBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Selected, like everything else that is selected. The outline round the
       chip, name and size turns green with the zone it belongs to. Declared
       late, since the plain outline style comes after it in the file. -->
  <Style Selector="Button.zoneTileButton.capturing Border.wholeZoneBlock">
    <Setter Property="BorderBrush" Value="{DynamicResource CaptureBorder}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Pointed at, and only while there is something to point at
       Hovering the middle band lifts its outline and its words together, so the
       block reads as one thing being pointed at rather than a box that happens
       to have text in it. A half does the same to its chip and size, which sit
       in a layer of their own above it - no selector reaches across, so they
       carry the half's hover as a class instead.

       Gated on .interactive, like every other hover in this diagram. Ungated,
       these three were the last thing outside edit mode that answered to a
       pointer: the outline went accent and thickened by a pixel, which nudged
       the chip and the name as it grew, so the one part of a picture that
       twitched under the cursor was the part that does nothing until Edit is
       pressed. A diagram that is only being read must be inert everywhere -
       the hover hint is text about the hotkey, not an offer to click. -->
  <!-- Declaration order carries the gate: Avalonia settles equally-weighted
       styles by order rather than specificity, so these have to stay after the
       plain wholeZoneBlock rules they override. -->
  <Style Selector="Button.zoneTileButton.interactive Border.wholeZoneBand:pointerover Border.wholeZoneBlock">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.zoneTileButton.interactive Border.wholeZoneBand:pointerover TextBlock.zoneName">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="Button.zoneTileButton.interactive Border.wholeZoneBand:pointerover TextBlock.zoneSize">
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
  </Style>

  <Style Selector="Border.keyChip.tierChip.hot TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.zoneSize.hot">
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
  </Style>

  <!-- Text goes white on the green, both here and on the whole-zone chip. The
       tier chip normally sits on a dark plate and its text is deliberately dim;
       left dim on a bright green fill it is barely readable, and the one chip
       you most need to read is the one you have just picked. -->
  <Style Selector="Border.keyChip.tierChip.capturing TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Border.keyChip.tierChip.capturing TextBlock.chipModifier">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.zoneTileButton.capturing Border.keyChip.primaryChip TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- A half waiting for a key, marked on its chip as well as its outline.
       The chip is decoration now, so it carries the state directly rather than
       through a button wrapped round it. -->
  <Style Selector="Border.keyChip.tierChip.capturing">
    <Setter Property="Background" Value="{DynamicResource CaptureBorder}" />
  </Style>


  <!-- The floating hint
       Looks like a tooltip and is not one: it lives in the diagram's own tree,
       so IsHitTestVisible=False actually keeps the pointer out of it. A real
       tooltip is a window, and a window takes the pointer whatever you do. -->
  <Style Selector="Border.hoverLabel">
    <Setter Property="Background" Value="{DynamicResource ChipBack}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #40000000" />
  </Style>

  <Style Selector="Border.hoverLabel TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
</Styles>
