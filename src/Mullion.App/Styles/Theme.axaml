<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Mullion.App.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SurfaceColor">#12151A</Color>
          <Color x:Key="PanelColor">#1A1E25</Color>
          <SolidColorBrush x:Key="Surface" Color="#12151A" />
          <SolidColorBrush x:Key="Panel" Color="#1A1E25" />
          <SolidColorBrush x:Key="PanelBorder" Color="#333A45" />
          <SolidColorBrush x:Key="Accent" Color="#4C8BF5" />
          <SolidColorBrush x:Key="AccentSoft" Color="#204C8BF5" />
          <SolidColorBrush x:Key="AccentMid" Color="#3D4C8BF5" />
          <SolidColorBrush x:Key="Ink" Color="#E8ECF3" />
          <SolidColorBrush x:Key="InkDim" Color="#98A2B3" />
          <SolidColorBrush x:Key="InkFaint" Color="#5D6675" />
          <SolidColorBrush x:Key="ChipBack" Color="#2A303B" />
          <SolidColorBrush x:Key="Taskbar" Color="#0C0E12" />
          <SolidColorBrush x:Key="SpanTint" Color="#28D9A441" />
          <SolidColorBrush x:Key="SpanBorder" Color="#D9A441" />
          <SolidColorBrush x:Key="CaptureTint" Color="#3833D17A" />
          <SolidColorBrush x:Key="CaptureBorder" Color="#33D17A" />
          <LinearGradientBrush x:Key="BezelFill" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#1E232B" />
            <GradientStop Offset="1" Color="#161A21" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <Color x:Key="SurfaceColor">#F4F6FA</Color>
          <Color x:Key="PanelColor">#FFFFFF</Color>
          <SolidColorBrush x:Key="Surface" Color="#F4F6FA" />
          <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PanelBorder" Color="#CFD6E0" />
          <SolidColorBrush x:Key="Accent" Color="#2563EB" />
          <SolidColorBrush x:Key="AccentSoft" Color="#1F2563EB" />
          <SolidColorBrush x:Key="AccentMid" Color="#3A2563EB" />
          <SolidColorBrush x:Key="Ink" Color="#131720" />
          <SolidColorBrush x:Key="InkDim" Color="#5A6472" />
          <SolidColorBrush x:Key="InkFaint" Color="#93A0B2" />
          <SolidColorBrush x:Key="ChipBack" Color="#E4E9F1" />
          <SolidColorBrush x:Key="Taskbar" Color="#DDE3EC" />
          <SolidColorBrush x:Key="SpanTint" Color="#2FB4801F" />
          <SolidColorBrush x:Key="SpanBorder" Color="#B4801F" />
          <SolidColorBrush x:Key="CaptureTint" Color="#3A1E8E4A" />
          <SolidColorBrush x:Key="CaptureBorder" Color="#1E8E4A" />
          <LinearGradientBrush x:Key="BezelFill" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#EEF1F6" />
          </LinearGradientBrush>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Monitor panel. The top-left corner is square so the name tab sitting in
       it meets straight edges: against a rounded corner the bezel curves away
       under the tab and the two read as separate objects. -->
  <Style Selector="Border.monitorBezel">
    <Setter Property="CornerRadius" Value="0,10,10,10" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="Background" Value="{DynamicResource BezelFill}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 6 20 0 #33000000" />
  </Style>

  <Style Selector="Border.taskbarStrip">
    <Setter Property="Background" Value="{DynamicResource Taskbar}" />
  </Style>

  <!-- Zone tiles. Templated flat so a Button reads as a zone, not a control. -->
  <Style Selector="Button.zoneTileButton">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Arrow" />

    <!-- All four are load-bearing for a to-scale diagram.
         Alignment: unless it is Stretch, Avalonia's ArrangeCore clamps the
         control to its DesiredSize instead of filling the rect the panel gave
         it, so every tile ends up content-sized and the 25/50/25 split stops
         looking like 25/50/25. Border defaults to Stretch; Button does not.
         MinWidth/MinHeight: Fluent gives Button non-zero defaults, and Arrange
         will not shrink below them, which inflates the narrow zones. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="tile"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <!-- A union drawn as a dimension line rather than a panel: end caps, a rule
       between them, and the label interrupting it. A filled rectangle here read
       as another monitor on the desk, which is the one thing it is not. -->
  <Style Selector="Button.spanMeasure">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />

    <!-- Stretch is load-bearing: without it Arrange clamps to DesiredSize and
         the measure stops lining up with the monitors it is measuring. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.spanMeasure Rectangle.measureRule">
    <Setter Property="Fill" Value="{DynamicResource InkFaint}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>


  <Style Selector="Button.spanMeasure Rectangle.measureCap">
    <Setter Property="Fill" Value="{DynamicResource InkFaint}" />
    <Setter Property="RadiusX" Value="1" />
    <Setter Property="RadiusY" Value="1" />
  </Style>


  <Style Selector="Button.spanMeasure.interactive">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.spanMeasure.interactive:pointerover Rectangle.measureRule">
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Button.spanMeasure.interactive:pointerover Rectangle.measureCap">
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Button.spanMeasure.capturing Rectangle.measureRule">
    <Setter Property="Fill" Value="{DynamicResource CaptureBorder}" />
  </Style>

  <Style Selector="Button.spanMeasure.capturing Rectangle.measureCap">
    <Setter Property="Fill" Value="{DynamicResource CaptureBorder}" />
  </Style>
  <!-- Only an interactive diagram invites clicking -->
  <Style Selector="Button.zoneTileButton.interactive">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.zoneTileButton.interactive:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentMid}" />
  </Style>

  <!-- A zone crossing a physical bezel is unusual enough to look different -->
  <Style Selector="Button.zoneTileButton.spanning">
    <Setter Property="Background" Value="{DynamicResource SpanTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SpanBorder}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Awaiting a keypress: unmistakable, since the next key goes here -->
  <Style Selector="Button.zoneTileButton.capturing">
    <Setter Property="Background" Value="{DynamicResource CaptureTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CaptureBorder}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>

  <!-- A region inside a zone, not a zone of its own: dashed and faded so the
       hierarchy reads at a glance. Border has no dash support in Avalonia,
       hence a Rectangle. -->
  <Style Selector="Rectangle.subZone">
    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="3,3" />
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="RadiusX" Value="4" />
    <Setter Property="RadiusY" Value="4" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Margin" Value="2" />
  </Style>

  <Style Selector="Border.keyChip">
    <Setter Property="Background" Value="{DynamicResource ChipBack}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <!-- Descendant selectors, not child ones: a chip's runs sit inside a panel
       that changes with how the chord is laid out, and a selector naming that
       panel silently stops matching the moment it does. -->
  <Style Selector="Border.keyChip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.keyChip.primaryChip TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Border.keyChip.tierChip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
  </Style>

  <!-- Dimmer than the key but the SAME size. It was smaller, which read well on
       one line and badly the moment a long chord wrapped: stacked, two type
       sizes in one chip look like a mistake rather than a hierarchy. Opacity
       alone still says "this part is context, the letter is the answer".
       Last, so it wins over the chip variants above without restating them. -->
  <Style Selector="Border.keyChip TextBlock.chipModifier">
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="0" />

    <!-- The key chips letter-space their text, which after a "+" reads as a
         space between the modifier and the key rather than as tracking. -->
    <Setter Property="LetterSpacing" Value="0" />
  </Style>

  <!-- The home-row key reads as the column's main target -->
  <Style Selector="Border.keyChip.primaryChip">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <Style Selector="Border.keyChip.primaryChip > TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- The chip on a span measure stands taller than a zone chip: it has to read
       as centered on the label block - the text and the rule beneath it - rather
       than on the rule alone, so it reaches up behind the text. The lift is a
       RenderTransform so the row it sits in stays centered on the rule. -->
  <Style Selector="Border.keyChip.spanChip">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="RenderTransform">
      <TranslateTransform Y="-6" />
    </Setter>
  </Style>

  <!-- Tier keys are secondary: same column, half the height -->
  <Style Selector="Border.keyChip.tierChip">
    <Setter Property="Padding" Value="7,1" />
  </Style>

  <Style Selector="Border.keyChip.tierChip > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
  </Style>

  <Style Selector="TextBlock.zoneName">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
  </Style>

  <Style Selector="TextBlock.zoneSize">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
  </Style>

  <!-- A tab attached to the top-left of its monitor: rounded on top, square
       along the bottom where it meets the bezel, sharing the bezel's fill and
       border so the two read as one object. Fixed height so the negative margin
       that lifts it can land its bottom edge exactly on the bezel's top. -->
  <!-- Two lines, not one. Side by side the name and the resolution made a tab
       far wider than a portrait monitor, and on a row of them each tab ran under
       its neighbour and was cut off mid-word. Stacked, the tab is only as wide
       as its longer line, which fits above the monitor it belongs to. -->
  <Style Selector="Border.monitorLabel">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="MaxHeight" Value="46" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="0,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource ChipBack}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
  </Style>

  <Style Selector="Border.monitorLabel > StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.monitorTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.monitorDetail">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
    <Setter Property="Margin" Value="0,-2,0,0" />
  </Style>

  <!-- Page furniture -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Layout choice cards -->
  <Style Selector="RadioButton.choiceCard">
    <Setter Property="Padding" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.choiceCard:checked">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="RadioButton.choiceCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Border.previewFrame">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- A square, quiet icon button. No border or fill until hovered, so it sits
       beside labelled buttons without competing with them. -->
  <Style Selector="Button.iconButton">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.iconButton > Path">
    <Setter Property="Fill" Value="{DynamicResource InkDim}" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <Style Selector="Button.iconButton:pointerover > Path">
    <Setter Property="Fill" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,6" />
  </Style>

  <!-- Distinct from a warning: nothing is wrong, but everything shown is
       fictional and must not be mistaken for the real machine. -->
  <Style Selector="Border.simulation">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.warning">
    <Setter Property="Background" Value="{DynamicResource SpanTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SpanBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>


  <!-- Split seams
       Nearly invisible until pointed at. A diagram with a bar drawn between
       every pair of zones reads as a layout made of bars, and the seams are
       incidental to what it is showing: they are how you change the picture,
       not part of it. Hover is what says a seam is there to be grabbed, and the
       cursor says which way it moves. -->
  <Style Selector="ctl|SplitHandle.seam">
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Transparent, not unset: a null background is not hit-testable, so
             the handle would be a control nothing can grab. -->
        <Border Background="Transparent">
          <Border Name="Grip" Background="{DynamicResource InkFaint}"
                  Opacity="0" CornerRadius="2"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Width="3" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ctl|SplitHandle.seam[Orientation=Horizontal]">
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>

  <!-- A seam on a stacked split runs across the display, so its grip lies flat
       and the cursor points the other way. -->
  <Style Selector="ctl|SplitHandle.seam[Orientation=Vertical]">
    <Setter Property="Cursor" Value="SizeNorthSouth" />
  </Style>

  <Style Selector="ctl|SplitHandle.seam[Orientation=Vertical] /template/ Border#Grip">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="3" />
  </Style>

  <Style Selector="ctl|SplitHandle.seam:pointerover /template/ Border#Grip">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="ctl|SplitHandle.seam /template/ Border#Grip">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
