<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mullion.App.ViewModels"
        x:Class="Mullion.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Mullion settings"
        Width="720" Height="760"
        MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}">

  <!-- Ordered by how often anyone comes here for it, and holding only what has
       nowhere else to live. Keys are bound on the main window by clicking the
       zone that wears them; a second list of the same bindings here was one more
       thing to keep in step, and it did not keep in step. -->
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <TextBlock Classes="h1" Text="Settings" />

      <Border Classes="warning" IsVisible="{Binding HasError}">
        <TextBlock Classes="body" Text="{Binding Error}" />
      </Border>

      <!-- Startup -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Startup" />

          <CheckBox Content="Start Mullion when I sign in"
                    IsChecked="{Binding StartWithWindows}" />

          <CheckBox Content="Start as administrator"
                    IsChecked="{Binding StartElevated}"
                    IsEnabled="{Binding StartWithWindows}"
                    Margin="20,0,0,0" />

          <TextBlock Classes="body" Margin="20,0,0,0"
                     Text="Registers a scheduled task so there is no UAC prompt at each sign-in. Setting this up requires running Mullion as administrator once." />

          <CheckBox Content="Always start in the tray"
                    IsChecked="{Binding StartInTray}" />

          <TextBlock Classes="body" Margin="20,0,0,0"
                     Text="Starting at sign-in always goes to the tray. Turn this on to do the same when Mullion is launched by hand, instead of opening this window." />

          <TextBlock Classes="body" Text="{Binding ElevationBlurb}" Margin="0,6,0,0" />

          <Button Content="Restart as administrator"
                  Command="{Binding RestartElevatedCommand}"
                  IsVisible="{Binding !IsElevated}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- Behavior -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Behavior" />

          <CheckBox Content="Flash the zone when a window moves"
                    IsChecked="{Binding ShowZoneFlash}" />

          <CheckBox Content="Drop a window into a zone by dragging it"
                    IsChecked="{Binding DragToSnap}" />

          <TextBlock Classes="body" Margin="20,0,0,0"
                     Text="Hold this while dragging and the zones appear; release over one to drop the window into it. Without a modifier every window drag raises the zones, which fights the edge snap built into Windows." />
          <ComboBox ItemsSource="{Binding DragModifiers}"
                    SelectedItem="{Binding SelectedDragModifier}"
                    IsEnabled="{Binding DragToSnap}"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Stretch" />

          <TextBlock Classes="body" Margin="0,6,0,0"
                     Text="Default modifier for zone hotkeys — what a zone is taken with unless you have bound it to something else yourself. Win is the default, and the reason Mullion installs a keyboard hook at all: Windows will not let an app claim Win+letter any other way." />
          <ComboBox ItemsSource="{Binding HotkeyModifiers}"
                    SelectedItem="{Binding SelectedHotkeyModifier}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>

      <!-- Layout -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Layout" />

          <TextBlock Classes="body" Text="Key surface — which block of keys zones are mapped onto." />
          <ComboBox ItemsSource="{Binding Surfaces}"
                    SelectedItem="{Binding SelectedSurface}"
                    HorizontalAlignment="Stretch" />

          <CheckBox Content="Allow zones that span two monitors"
                    IsChecked="{Binding AllowSpanningUnions}" />
          <TextBlock Classes="body" Margin="24,0,0,0"
                     Text="Only offered when the monitors form a clean rectangle — adjacent, aligned, and at the same scaling." />

          <Button Content="Re-run setup wizard…"
                  Command="{Binding RerunWizardCommand}"
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0" />

          <!-- The whole layout as a file: zone shapes, counts and key
               bindings. Here rather than on a card of its own, which is what
               was left of "Splits" once the diagram grew its own stepper. -->
          <TextBlock Classes="body" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="A layout file carries the zone shapes and how each display is split, so an arrangement worked out on one machine can be moved to another." />

          <Border Classes="warning" IsVisible="{Binding LayoutMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="body" Text="{Binding LayoutMessage}" TextWrapping="Wrap" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Export layout…" Command="{Binding ExportLayoutCommand}" />
            <Button Content="Import layout…" Command="{Binding ImportLayoutCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The hotkeys that are not zones.

           Here rather than on the diagram because there is nothing to point at:
           they act on whatever has focus, so no rectangle on the desk stands for
           one. Zone keys stay on the diagram, where the picture says which key
           goes where far better than a list could. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Actions" />

          <TextBlock Classes="body" TextWrapping="Wrap"
                     Text="Hotkeys that act on the focused window rather than sending it somewhere. They sit outside the key surface on purpose — the allocator may claim any surface key when a monitor is plugged in, and an action bound there would stop working." />

          <ItemsControl ItemsSource="{Binding Actions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActionRowViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                  <TextBlock Grid.Column="0" Classes="body" Text="{Binding Title}"
                             VerticalAlignment="Center" />

                  <!-- The chord doubles as the button that changes it: the thing
                       you want to change is the thing you click, and it is the
                       only part of the row worth pointing at. -->
                  <Button Grid.Column="1" Classes="chordButton"
                          Classes.capturing="{Binding IsCapturing}"
                          Content="{Binding Display}"
                          Command="{Binding RebindCommand}"
                          Margin="8,0,0,0" />

                  <Button Grid.Column="2" Content="Reset"
                          Command="{Binding ResetCommand}"
                          IsVisible="{Binding IsCustom}"
                          Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="body" TextWrapping="Wrap"
                     Text="{Binding ActionMessage}"
                     IsVisible="{Binding ActionMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <!-- Advanced.

           On its own card because its one setting says, in its own text, to
           change it only when something is already wrong. Beside a checkbox
           about a flash animation it read as an ordinary preference. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Advanced" />

          <TextBlock Classes="body" TextWrapping="Wrap"
                     Text="Windows key handling — how Mullion stops the Start menu opening when it takes a Win shortcut. Change this only if the Start menu appears when it should not." />
          <ComboBox ItemsSource="{Binding SuppressionModes}"
                    SelectedItem="{Binding SelectedSuppression}"
                    HorizontalAlignment="Stretch" />

          <!-- Anything but the default degrades the app's most visible
               behavior, so it says so rather than sitting silently. -->
          <Border Classes="warning" IsVisible="{Binding !SuppressionIsDefault}">
            <StackPanel Spacing="8">
              <TextBlock Classes="body" Text="{Binding SuppressionWarning}" />
              <Button Content="Use the recommended setting"
                      Command="{Binding ResetSuppressionCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="About" />
          <TextBlock Classes="body" Text="{Binding VersionLine}" />

          <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding CanCheckForUpdates}">
            <CheckBox Content="Check for updates once a day"
                      IsChecked="{Binding CheckForUpdates}" />

            <TextBlock Classes="body" Margin="20,0,0,0"
                       Text="Asks GitHub whether a newer release has been published. Nothing about you, this machine or your layout is sent, and this is the only time Mullion uses the network — turning it off makes the app silent." />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Check now"
                      Command="{Binding CheckForUpdatesNowCommand}"
                      IsEnabled="{Binding !IsCheckingForUpdates}" />

              <!-- Downloads and verifies; changes nothing yet. -->
              <Button Content="Download update"
                      Command="{Binding DownloadUpdateCommand}"
                      IsVisible="{Binding CanDownloadUpdate}"
                      IsEnabled="{Binding !IsDownloadingUpdate}" />

              <!-- The step that actually replaces the app, on its own, after
                   the slow and failable part is already done. -->
              <Button Content="Restart to finish"
                      Classes="accent"
                      Command="{Binding InstallUpdateCommand}"
                      IsVisible="{Binding UpdateStaged}" />

              <Button Content="Cancel"
                      Command="{Binding CancelUpdateDownloadCommand}"
                      IsVisible="{Binding IsDownloadingUpdate}" />

              <!-- Where self-updating is impossible, the manual route is the
                   only route, so it takes the place of the download button. -->
              <Button Content="Open the releases page"
                      Command="{Binding OpenUpdatePageCommand}"
                      IsVisible="{Binding !CanSelfUpdate}" />
            </StackPanel>

            <ProgressBar Minimum="0" Maximum="1"
                         Value="{Binding UpdateProgress}"
                         Height="4"
                         IsVisible="{Binding IsDownloadingUpdate}" />

            <TextBlock Classes="body"
                       Text="{Binding UpdateMessage}"
                       IsVisible="{Binding UpdateMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBlock Classes="body"
                       Text="{Binding SelfUpdateBlocked}"
                       IsVisible="{Binding SelfUpdateBlocked, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <TextBlock Classes="h2" Text="Configuration file" Margin="0,8,0,0" />
          <TextBlock Classes="zoneSize" Text="{Binding ConfigPath}" TextWrapping="Wrap" />

          <TextBlock Classes="h2" Text="Log file" Margin="0,8,0,0" />
          <TextBlock Classes="zoneSize" Text="{Binding LogPath}" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Content="Open config folder" Command="{Binding OpenConfigFolderCommand}" />
            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>
