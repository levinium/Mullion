<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Mullion.App.Controls"
        xmlns:vm="using:Mullion.App.ViewModels"
        x:Class="Mullion.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Mullion settings"
        Width="720" Height="760"
        MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <TextBlock Classes="h1" Text="Settings" />

      <Border Classes="warning" IsVisible="{Binding HasError}">
        <TextBlock Classes="body" Text="{Binding Error}" />
      </Border>

      <!-- Startup -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Startup" />

          <CheckBox Content="Start Mullion when I sign in"
                    IsChecked="{Binding StartWithWindows}" />

          <CheckBox Content="Start as administrator"
                    IsChecked="{Binding StartElevated}"
                    IsEnabled="{Binding StartWithWindows}"
                    Margin="20,0,0,0" />

          <TextBlock Classes="body" Margin="20,0,0,0"
                     Text="Registers a scheduled task so there is no UAC prompt at each sign-in. Setting this up requires running Mullion as administrator once." />

          <TextBlock Classes="body" Text="{Binding ElevationBlurb}" Margin="0,6,0,0" />

          <Button Content="Restart as administrator"
                  Command="{Binding RestartElevatedCommand}"
                  IsVisible="{Binding !IsElevated}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- Layout -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Layout" />

          <TextBlock Classes="body" Text="Key surface — which block of keys zones are mapped onto." />
          <ComboBox ItemsSource="{Binding Surfaces}"
                    SelectedItem="{Binding SelectedSurface}"
                    HorizontalAlignment="Stretch" />

          <CheckBox Content="Allow zones that span two monitors"
                    IsChecked="{Binding AllowSpanningUnions}" />
          <TextBlock Classes="body" Margin="24,0,0,0"
                     Text="Only offered when the monitors form a clean rectangle — adjacent, aligned, and at the same scaling." />

          <Button Content="Re-run setup wizard…"
                  Command="{Binding RerunWizardCommand}"
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <!-- Behavior -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Behavior" />

          <CheckBox Content="Flash the zone when a window moves"
                    IsChecked="{Binding ShowZoneFlash}" />

          <TextBlock Classes="body" Margin="0,6,0,0"
                     Text="Windows key handling — how Mullion stops the Start menu opening when it takes a Win shortcut. Change this only if the Start menu appears when it should not." />
          <ComboBox ItemsSource="{Binding SuppressionModes}"
                    SelectedItem="{Binding SelectedSuppression}"
                    HorizontalAlignment="Stretch" />

          <!-- Anything but the default degrades the app's most visible
               behaviour, so it says so rather than sitting silently. -->
          <Border Classes="warning" IsVisible="{Binding !SuppressionIsDefault}">
            <StackPanel Spacing="8">
              <TextBlock Classes="body" Text="{Binding SuppressionWarning}" />
              <Button Content="Use the recommended setting"
                      Command="{Binding ResetSuppressionCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Current bindings -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Hotkeys" />
          <TextBlock Classes="body"
                     Text="Press a key again while holding Win to widen the window through its cycle." />

          <Border Classes="warning" IsVisible="{Binding RebindMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="body" Text="{Binding RebindMessage}" />
          </Border>

          <!-- The picture is the control: click a zone to rebind it, rather
               than hunting for the matching row in a table below. -->
          <Border Classes="card" Height="230" Padding="10">
            <ctl:MonitorDiagram DataContext="{Binding Diagram}" />
          </Border>

          <TextBlock Classes="body"
                     Text="Click a zone above to give it a different key, or use the list." />

          <ItemsControl ItemsSource="{Binding Bindings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BindingRowViewModel">
                <Grid ColumnDefinitions="110,*,Auto" Margin="0,3">
                  <Border Classes="keyChip" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Key}" />
                  </Border>

                  <TextBlock Grid.Column="1" Classes="body" Text="{Binding Zone}"
                             VerticalAlignment="Center" Margin="10,0,0,0" />

                  <Button Grid.Column="2"
                          Content="{Binding ButtonLabel}"
                          MinWidth="100"
                          Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RebindCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Reset layout to default"
                  Command="{Binding ResetLayoutCommand}"
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <!-- Config -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Configuration file" />
          <TextBlock Classes="zoneSize" Text="{Binding ConfigPath}" TextWrapping="Wrap" />
          <Button Content="Open folder" Command="{Binding OpenConfigFolderCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>
