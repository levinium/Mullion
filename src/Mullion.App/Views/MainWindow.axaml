<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Mullion.App.Controls"
        xmlns:vm="using:Mullion.App.ViewModels"
        x:Class="Mullion.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mullion"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Classes="h1" Text="Your displays" />
        <TextBlock Classes="body" Text="{Binding TopologySummary}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Rescan" Command="{Binding RescanCommand}" />
        <ToggleButton Content="Pause hotkeys"
                      IsChecked="{Binding IsPaused}"
                      Command="{Binding TogglePauseCommand}" />
      </StackPanel>
    </Grid>

    <!-- Diagram + conflicts -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">

      <ItemsControl Grid.Row="0"
                    ItemsSource="{Binding Conflicts}"
                    IsVisible="{Binding HasConflicts}"
                    Margin="0,0,0,14">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConflictViewModel">
            <Border Classes="warning" Margin="0,0,0,8">
              <StackPanel Spacing="4">
                <TextBlock Classes="h2" Text="{Binding Source}" />
                <TextBlock Classes="body" Text="{Binding Summary}" />
                <TextBlock Classes="body" Text="{Binding Advice}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Grid.Row="1" Classes="card">
        <ctl:MonitorDiagram DataContext="{Binding Diagram}" />
      </Border>
    </Grid>

    <!-- Status -->
    <Border Grid.Row="2" Classes="card" Margin="0,16,0,0">
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="h2" Text="Hotkeys" />
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="body" Text="{Binding HookStatus}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Classes="body" Text="{Binding PrivilegeStatus}" Margin="0,4,0,0" />

        <TextBlock Grid.Row="0" Grid.Column="1" Classes="h2" Text="Last action" Margin="20,0,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding LastAction}" Margin="20,0,0,0" />
      </Grid>
    </Border>

  </Grid>
</Window>
