<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Mullion.App.Controls"
        xmlns:vm="using:Mullion.App.ViewModels"
        x:Class="Mullion.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mullion"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Classes="h1" Text="Your displays" />
        <TextBlock Classes="body" Text="{Binding TopologySummary}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="iconButton"
                Command="{Binding RescanCommand}"
                ToolTip.Tip="Rescan the displays">
          <Path Data="{x:Static ctl:Icons.Refresh}" />
        </Button>

        <!-- One button showing what pressing it will do, rather than a toggle
             showing what is already the case: at a glance a pressed-in "pause"
             and an unpressed one look far too alike to tell whether the hotkeys
             are live. -->
        <Button Classes="iconButton"
                Command="{Binding TogglePauseCommand}"
                ToolTip.Tip="{Binding PauseTooltip}">
          <Path Data="{Binding PauseIcon}" />
        </Button>

        <!-- Furthest right, where a settings control is conventionally looked
             for. Unlabelled, so it carries a tooltip. -->
        <Button Classes="iconButton"
                Command="{Binding ShowSettingsCommand}"
                ToolTip.Tip="Settings">
          <Path Data="{x:Static ctl:Icons.Gear}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Diagram + notices -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">

      <!-- All notices stack; several can apply at once. -->
      <StackPanel Grid.Row="0">

      <!-- Unmistakable, because everything below it is fictional. -->
      <Border Classes="simulation" Margin="0,0,0,14" IsVisible="{Binding IsSimulating}">
        <TextBlock Classes="body" Text="{Binding SimulationLine}" />
      </Border>

      <!-- Elevation banner. Placed at the top because the failure it describes
           is otherwise invisible: an elevated window's keystrokes never reach
           Mullion, so there is no failed hotkey to report anywhere else. -->
      <Border Classes="warning" Margin="0,0,0,14"
              IsVisible="{Binding ShowElevationBanner}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="h2" Text="{Binding ElevationHeadline}" />
            <TextBlock Classes="body" Text="{Binding ElevationDetail}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="accent"
                  Content="Restart as administrator"
                  Command="{Binding RestartElevatedCommand}"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0" />
        </Grid>
      </Border>

      <!-- Two zone managers on one gesture do not look like a conflict from the
           outside; they look like Mullion being unreliable. Naming it is worth
           more than the drag itself working. -->
      <Border Classes="warning" Margin="0,0,0,14"
              IsVisible="{Binding ShowDragConflictBanner}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="h2" Text="Another window manager is competing" />
            <TextBlock Classes="body" Text="{Binding DragConflictDetail}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="accent"
                  Content="{Binding DragConflictAction}"
                  Command="{Binding ResolveDragConflictCommand}"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0" />
        </Grid>
      </Border>

      <Border Classes="warning" Margin="0,0,0,14"
              IsVisible="{Binding HasTrayFailure}">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="No tray icon" />
          <TextBlock Classes="body" Text="{Binding TrayFailure}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Conflicts}"
                    IsVisible="{Binding HasConflicts}"
                    Margin="0,0,0,14">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConflictViewModel">
            <Border Classes="warning" Margin="0,0,0,8">
              <StackPanel Spacing="4">
                <TextBlock Classes="h2" Text="{Binding Source}" />
                <TextBlock Classes="body" Text="{Binding Summary}" />
                <TextBlock Classes="body" Text="{Binding Advice}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      </StackPanel>

      <!-- Tighter than a normal card: the diagram letterboxes itself to keep
           the desk to scale, so it arrives with slack of its own and does not
           need a full 16 on top of it. -->
      <Border Grid.Row="1" Classes="card" Padding="12">
        <ctl:ZoneEditor DataContext="{Binding Editor}" />
      </Border>
    </Grid>

    <!-- Status -->
    <Border Grid.Row="2" Classes="card" Margin="0,16,0,0">
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="h2" Text="Hotkeys" />
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="body" Text="{Binding HookStatus}" />
        <!-- Hidden while the banner is up, which says the same thing louder. -->
        <TextBlock Grid.Row="2" Grid.Column="0" Classes="body" Text="{Binding PrivilegeStatus}"
                   Margin="0,4,0,0" IsVisible="{Binding !ShowElevationBanner}" />

        <TextBlock Grid.Row="0" Grid.Column="1" Classes="h2" Text="Last action" Margin="20,0,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding LastAction}" Margin="20,0,0,0" />
      </Grid>
    </Border>

  </Grid>
</Window>
