<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Mullion.App.Controls"
             xmlns:vm="using:Mullion.App.ViewModels"
             x:Class="Mullion.App.Controls.MonitorDiagram"
             x:DataType="vm:MonitorDiagramViewModel">

  <!-- The diagram, with a label floating over it that follows the pointer.

       A tooltip would be a window of its own, and a window takes the pointer:
       the region being described lost its highlight the moment the tip appeared
       over it, and a click aimed at the zone landed on the popup. Following the
       cursor does not fix that on its own - a readable label has to sit clear of
       the pointer, so you can always move onto it.

       Drawn in the diagram's own tree instead, where IsHitTestVisible=False
       means exactly what it says: the pointer passes through it. -->
  <Panel>
  <ItemsControl ItemsSource="{Binding Nodes}">

    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <ctl:VirtualScreenPanel VirtualBounds="{Binding VirtualBounds}" Gap="10" TopHeadroom="46" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <!-- DataType is required on container-theme setters: a compiled binding here
         otherwise resolves against the ItemsControl's own DataType, not the item. -->
    <ItemsControl.ItemContainerTheme>
      <ControlTheme TargetType="ContentPresenter">
        <Setter Property="ctl:VirtualScreenPanel.Rect"
                Value="{Binding Bounds, DataType=vm:DiagramNodeViewModel}" />

        <!-- Monitors scale freely; a measure's label does not shrink, so its
             gutter is reserved in device pixels instead. -->
        <Setter Property="ctl:VirtualScreenPanel.Lane"
                Value="{Binding Lane, DataType=vm:DiagramNodeViewModel}" />
        <Setter Property="ctl:VirtualScreenPanel.LaneAnchor"
                Value="{Binding LaneAnchor, DataType=vm:DiagramNodeViewModel}" />
        <Setter Property="ctl:VirtualScreenPanel.LaneSlot"
                Value="{Binding LaneSlot, DataType=vm:DiagramNodeViewModel}" />
        <Setter Property="ctl:VirtualScreenPanel.LaneThickness"
                Value="{Binding LaneThickness, DataType=vm:DiagramNodeViewModel}" />

        <!-- The name tab deliberately overflows above its display, into the
             headroom the panel reserves, so the container must not crop it. -->
        <Setter Property="ClipToBounds" Value="False" />
      </ControlTheme>
    </ItemsControl.ItemContainerTheme>

    <!-- Two node kinds share the panel, so both templates go in DataTemplates
         and are selected by type. ItemTemplate cannot be used for either: when
         set it applies to every item regardless of its type. -->
    <ItemsControl.DataTemplates>

      <!-- A union is drawn the way a drawing dimensions something: end caps and
           a rule reaching exactly as far as the span does, the key chip riding
           the rule, and the description tucked just off it. Not a filled panel -
           that read as another monitor sitting on the desk. The vertical form
           below is the same arrangement turned on its side.

           Chip and text are placed either side of the boundary between two star
           tracks rather than at fixed points on the rule. Star tracks grow to
           fit their content, so a label too long for its half pushes the
           boundary back and carries the chip with it: the two stay joined, the
           text stays inside the rule, and with a short label the boundary is
           simply the midpoint. That is what keeps every length working without
           a measured width anywhere. -->
      <DataTemplate x:DataType="vm:HorizontalSpanViewModel">
        <Button Classes="spanMeasure"
                Classes.capturing="{Binding IsCapturing}"
                Classes.interactive="{Binding IsInteractive}"
                IsHitTestVisible="{Binding IsInteractive}"
                Command="{Binding ActivateCommand}"
                PointerEntered="OnSpanEntered"
                PointerExited="OnHoverLeft">
          <Grid RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">

            <!-- The halves of the span, above and below the rule: the same
                 "upper / whole / lower" the key rows mean, in the same vertical
                 order. Three separate rules stacked under the desk would all
                 look alike and say nothing about which was which. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" Margin="0,0,0,10"
                        IsVisible="{Binding HasUpper}">
              <Border Classes="keyChip tierChip">
                <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="chipModifier"
                                     Text="{Binding UpperModifierPrefix}" />
                          <TextBlock Text="{Binding UpperKey}" />
                        </StackPanel>
              </Border>
              <TextBlock Classes="zoneSize" Text="{Binding UpperSize}"
                         IsVisible="{Binding $parent[ctl:MonitorDiagram].Detailed}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <Panel Grid.Row="1">

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
              <Rectangle Grid.Column="0" Classes="measureCap" Width="2" Height="10" />
              <Rectangle Grid.Column="1" Classes="measureRule" Height="1" />
              <Rectangle Grid.Column="2" Classes="measureCap" Width="2" Height="10" />
            </Grid>

            <Grid ColumnDefinitions="*,*">

              <!-- Tall enough to span the label block, not just the rule: it
                   reaches from the top of the text down past the line, and is
                   raised so it is centered on the two together. -->
              <Border Grid.Column="0" Classes="keyChip primaryChip spanChip"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="chipModifier"
                               Text="{Binding ModifierPrefix}" />
                    <TextBlock Text="{Binding KeyLabel}" />
                  </StackPanel>
              </Border>

              <!-- Beside the chip, not stacked over it, and lifted so it rests
                   just above the rule. A RenderTransform rather than a margin
                   precisely because it does NOT affect layout: the row stays
                   centered on the rule, so the chip goes on carrying the line
                   while the text clears it. -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="6,0,0,0">
                <StackPanel.RenderTransform>
                  <TranslateTransform Y="-11" />
                </StackPanel.RenderTransform>
                <TextBlock Classes="zoneName" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Classes="zoneSize" Text="{Binding SizeLabel}"
                           IsVisible="{Binding $parent[ctl:MonitorDiagram].Detailed}"
                           VerticalAlignment="Center" />
              </StackPanel>

            </Grid>
            </Panel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" Margin="0,-3,0,0"
                        IsVisible="{Binding HasLower}">
              <Border Classes="keyChip tierChip">
                <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="chipModifier"
                                     Text="{Binding LowerModifierPrefix}" />
                          <TextBlock Text="{Binding LowerKey}" />
                        </StackPanel>
              </Border>
              <TextBlock Classes="zoneSize" Text="{Binding LowerSize}"
                         IsVisible="{Binding $parent[ctl:MonitorDiagram].Detailed}"
                         VerticalAlignment="Center" />
            </StackPanel>

          </Grid>
        </Button>
      </DataTemplate>

      <!-- The same measure stood on end. A span up a stack of monitors belongs
           beside them, not underneath: underneath it would appear to measure
           their combined width, which is not what the key does.

           Turning the label puts its underline edge to one side, and the rule
           goes on exactly that side - so a measure on the left reads
           bottom-to-top with its rule on the right, and one on the right reads
           top-to-bottom with its rule on the left. Both then read outward from
           the desk.

           The text BEGINS at the chip and runs outward from it, as it does when
           the measure is horizontal; centered on the rule instead, it ran past
           the chip on both sides and the chip appeared to float in the middle of
           the words rather than introduce them. Both sit against the boundary
           between the two star rows, so a label too long for its half moves the
           boundary and the chip together instead of running off the end.

           LayoutTransformControl, not RenderTransform: the gutter has to size to
           the turned label, and a render transform would leave the layout still
           thinking it is horizontal. Two fixed rotations rather than one bound
           angle, because a transform is not in the logical tree and the
           DataContext a compiled binding needs does not reach it. -->
      <DataTemplate x:DataType="vm:VerticalSpanViewModel">
        <Button Classes="spanMeasure"
                Classes.capturing="{Binding IsCapturing}"
                Classes.interactive="{Binding IsInteractive}"
                IsHitTestVisible="{Binding IsInteractive}"
                Command="{Binding ActivateCommand}"
                PointerEntered="OnSpanEntered"
                PointerExited="OnHoverLeft">
          <!-- Rule, chip and text OVERLAID rather than laid out in columns. In
               columns the chip sized the rule's column, so a longer key pushed
               the text away from the line it is meant to sit against - and the
               chip is the one thing here whose width is not known in advance.
               Overlaid, the rule stays in the middle whatever the chip
               measures, and the text is a fixed step to one side of it. -->
          <Panel>

            <Grid RowDefinitions="Auto,*,Auto" HorizontalAlignment="Center">
              <Rectangle Grid.Row="0" Classes="measureCap" Height="2" Width="10" />
              <Rectangle Grid.Row="1" Classes="measureRule" Width="1" />
              <Rectangle Grid.Row="2" Classes="measureCap" Height="2" Width="10" />
            </Grid>

            <!-- Chip and text share ONE pair of star rows, so a label too long
                 for its half moves the two together rather than parting them. -->
            <Grid RowDefinitions="*,*">

              <!-- Reading bottom-to-top: the text hangs above the middle and the
                   chip sits on it, so the eye meets the chip first. -->
              <LayoutTransformControl Grid.Row="0"
                                      VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                      Margin="0,0,0,4"
                                      IsVisible="{Binding ReadsUpward}">
                <LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="-90" />
                </LayoutTransformControl.LayoutTransform>
                <LayoutTransformControl.RenderTransform>
                  <TranslateTransform X="-11" />
                </LayoutTransformControl.RenderTransform>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="zoneName" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Classes="zoneSize" Text="{Binding SizeLabel}"
                             IsVisible="{Binding $parent[ctl:MonitorDiagram].Detailed}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </LayoutTransformControl>

              <Border Grid.Row="1" Classes="keyChip primaryChip"
                      VerticalAlignment="Top" HorizontalAlignment="Center"
                      IsVisible="{Binding ReadsUpward}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="chipModifier"
                             Text="{Binding ModifierPrefix}" />
                  <TextBlock Text="{Binding KeyLabel}" />
                </StackPanel>
              </Border>

              <!-- Reading top-to-bottom: the mirror image. -->
              <Border Grid.Row="0" Classes="keyChip primaryChip"
                      VerticalAlignment="Bottom" HorizontalAlignment="Center"
                      IsVisible="{Binding ReadsDownward}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="chipModifier"
                             Text="{Binding ModifierPrefix}" />
                  <TextBlock Text="{Binding KeyLabel}" />
                </StackPanel>
              </Border>

              <LayoutTransformControl Grid.Row="1"
                                      VerticalAlignment="Top" HorizontalAlignment="Center"
                                      Margin="0,4,0,0"
                                      IsVisible="{Binding ReadsDownward}">
                <LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="90" />
                </LayoutTransformControl.LayoutTransform>
                <LayoutTransformControl.RenderTransform>
                  <TranslateTransform X="11" />
                </LayoutTransformControl.RenderTransform>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="zoneName" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Classes="zoneSize" Text="{Binding SizeLabel}"
                             IsVisible="{Binding $parent[ctl:MonitorDiagram].Detailed}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </LayoutTransformControl>

            </Grid>
          </Panel>
        </Button>
      </DataTemplate>
      <DataTemplate x:DataType="vm:DisplayNodeViewModel">

        <Panel>

          <!-- A tab on top of the monitor, meeting its square top-left corner.
               A negative margin floats it clear without shrinking the bezel, so
               the diagram stays exactly to scale and the zone area is left
               entirely to zones. It drops into the corner INSIDE the monitor
               only where a display sits directly above and there is no room. -->
          <!-- In a Canvas, not the Panel directly: a Panel offers its children
               only the display's own width, and a tab on a narrow monitor was
               then clamped to it while its text carried on past the box. A
               Canvas measures unconstrained, so the box grows with the text and
               simply overhangs the monitor, which is what a tab should do. -->
          <Canvas ZIndex="10" IsVisible="{Binding $parent[ctl:MonitorDiagram].Detailed}">
            <!-- Never wider than the monitor it names: the Canvas would happily
                 let it run on, which on a narrow display left the tab hanging
                 far out to the right of everything - and on a row of displays,
                 straight over the next monitor's tab. Capped to the display and
                 wrapped instead, with the full text on hover.

                 Anchored by its BOTTOM edge to the top of the display, so a tab
                 that wraps onto more lines grows upward into the headroom rather
                 than downward over the zones. Canvas.Bottom is measured from the
                 canvas's own bottom, and the canvas is the display, so binding
                 it to the canvas height puts the tab's foot on the display's
                 head whatever the tab's height turns out to be. -->
            <Border Classes="monitorLabel" IsVisible="{Binding LabelAbove}"
                    Canvas.Left="0"
                    Canvas.Bottom="{Binding $parent[Canvas].Bounds.Height}"
                    MaxWidth="{Binding $parent[Canvas].Bounds.Width,
                              Converter={x:Static ctl:ReserveWhenWideConverter.Instance},
                              ConverterParameter=150;76}"
                    CornerRadius="8,8,0,0" BorderThickness="1,1,1,0"
                    ToolTip.Tip="{Binding TitleAndDetail}">
              <StackPanel Orientation="Vertical">
                <TextBlock Classes="monitorTitle" Text="{Binding Title}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="monitorDetail" Text="{Binding Detail}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <!-- Inside the top-left corner, for a display with another directly
                 above it: there is no room over it, and a tab drawn there would
                 appear to label the display above. -->
            <Border Classes="monitorLabel" IsVisible="{Binding LabelInside}"
                    Canvas.Left="0" Canvas.Top="0"
                    MaxWidth="{Binding $parent[Canvas].Bounds.Width,
                              Converter={x:Static ctl:ReserveWhenWideConverter.Instance},
                              ConverterParameter=150;76}"
                    CornerRadius="0,0,8,0" BorderThickness="0,0,1,1"
                    ToolTip.Tip="{Binding TitleAndDetail}">
              <StackPanel Orientation="Vertical">
                <TextBlock Classes="monitorTitle" Text="{Binding Title}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="monitorDetail" Text="{Binding Detail}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <!-- Zone stepper, opposite the name tab.
                 On the display it changes rather than in a lone pair of buttons
                 somewhere on the page: with more than one monitor, a bare + and
                 - cannot say which display they would split, and here the answer
                 is the thing it is sitting on. Follows the tab's own rule about
                 where there is room - above when the display has clearance,
                 tucked inside its corner when another display is stacked over
                 it. -->
            <Border Classes="zoneStepper"
                    Canvas.Right="0"
                    Canvas.Bottom="{Binding $parent[Canvas].Bounds.Height}"
                    CornerRadius="8,8,0,0" BorderThickness="1,1,1,0">
              <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="CanEditZoneCount" />
                  <Binding Path="$parent[Canvas].Bounds.Width"
                           Converter="{x:Static ctl:WiderThanConverter.Instance}"
                           ConverterParameter="150" />
                  <Binding Path="LabelAbove" />
                </MultiBinding>
              </Border.IsVisible>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="stepperButton" Content="&#x2212;"
                        Command="{Binding RemoveZoneCommand}"
                        IsEnabled="{Binding CanRemoveZone}"
                        ToolTip.Tip="One fewer zone on this display" />
                <TextBlock Classes="stepperCount" Text="{Binding ZoneCount}" />
                <Button Classes="stepperButton" Content="+"
                        Command="{Binding AddZoneCommand}"
                        IsEnabled="{Binding CanAddZone}"
                        ToolTip.Tip="One more zone on this display" />
              </StackPanel>
            </Border>

            <Border Classes="zoneStepper"
                    Canvas.Right="0" Canvas.Top="0"
                    CornerRadius="0,0,0,8" BorderThickness="1,0,0,1">
              <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="CanEditZoneCount" />
                  <Binding Path="$parent[Canvas].Bounds.Width"
                           Converter="{x:Static ctl:WiderThanConverter.Instance}"
                           ConverterParameter="150" />
                  <Binding Path="LabelInside" />
                </MultiBinding>
              </Border.IsVisible>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="stepperButton" Content="&#x2212;"
                        Command="{Binding RemoveZoneCommand}"
                        IsEnabled="{Binding CanRemoveZone}"
                        ToolTip.Tip="One fewer zone on this display" />
                <TextBlock Classes="stepperCount" Text="{Binding ZoneCount}" />
                <Button Classes="stepperButton" Content="+"
                        Command="{Binding AddZoneCommand}"
                        IsEnabled="{Binding CanAddZone}"
                        ToolTip.Tip="One more zone on this display" />
              </StackPanel>
            </Border>
          </Canvas>

          <Border Classes="monitorBezel">
          <Grid>

            <!-- Taskbar strip, so the diagram matches what is actually on the desk -->
            <Canvas IsVisible="{Binding HasTaskbar}">
              <ctl:NormalizedPanel Width="{Binding $parent[Grid].Bounds.Width}"
                                   Height="{Binding $parent[Grid].Bounds.Height}"
                                   Gap="0">
                <Border Classes="taskbarStrip"
                        ctl:NormalizedPanel.Area="{Binding TaskbarArea}" />
              </ctl:NormalizedPanel>
            </Canvas>

            <ItemsControl ItemsSource="{Binding Cells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ctl:NormalizedPanel Gap="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>

              <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                  <Setter Property="ctl:NormalizedPanel.Area"
                          Value="{Binding Area, DataType=vm:ZoneCellViewModel}" />
                </ControlTheme>
              </ItemsControl.ItemContainerTheme>

              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ZoneCellViewModel">
                  <!-- A Button so the tile is clickable where the diagram is
                       interactive; templated flat so it reads as a zone, not a
                       control. Non-interactive diagrams leave the command null. -->
                  <Button Classes="zoneTileButton"
                          Classes.spanning="{Binding SpansDisplays}"
                          Classes.capturing="{Binding IsCapturing}"
                          Classes.interactive="{Binding IsInteractive}"
                          IsHitTestVisible="{Binding IsInteractive}"
                          Command="{Binding ActivateCommand}">

                    <Grid>

                      <!-- Hovering the whole tile, meaning the whole column -
                       but only where the pointer is not inside one of the
                       halves. A parent counts as hovered while any child is,
                       so without excluding them the tile would light up at the
                       same time as the half inside it and neither would say
                       what a click was about to do. -->
                      <Border Classes="zoneHighlight">
                        <Border.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsInteractive" />
                            <Binding Path="$parent[Button].IsPointerOver" />
                            <Binding ElementName="UpperRegion" Path="IsPointerOver"
                                     Converter="{x:Static BoolConverters.Not}" />
                            <Binding ElementName="LowerRegion" Path="IsPointerOver"
                                     Converter="{x:Static BoolConverters.Not}" />
                          </MultiBinding>
                        </Border.IsVisible>
                      </Border>

                      <!-- The upper and lower halves, drawn as they actually
                           are and clickable as what they are. Dashed and faded
                           so they read as regions inside this zone rather than
                           as separate zones beside it.

                           The whole half is the target, not just the chip on
                           it: the thing being pointed at has to be the thing
                           that changes, or the diagram is a picture with a few
                           small hidden buttons scattered over it. -->
                      <Grid RowDefinitions="*,*" Margin="3">
                        <Button Grid.Row="0" Name="UpperRegion" Classes="subZoneRegion"
                                IsVisible="{Binding HasUpper}"
                                Classes.capturing="{Binding IsUpperCapturing}"
                                Classes.interactive="{Binding IsUpperInteractive}"
                                IsHitTestVisible="{Binding IsUpperInteractive}"
                                Command="{Binding ActivateUpperCommand}"
                                PointerEntered="OnUpperEntered"
                                PointerExited="OnHoverLeft" />

                        <Button Grid.Row="1" Name="LowerRegion" Classes="subZoneRegion"
                                IsVisible="{Binding HasLower}"
                                Classes.capturing="{Binding IsLowerCapturing}"
                                Classes.interactive="{Binding IsLowerInteractive}"
                                IsHitTestVisible="{Binding IsLowerInteractive}"
                                Command="{Binding ActivateLowerCommand}"
                                PointerEntered="OnLowerEntered"
                                PointerExited="OnHoverLeft" />
                      </Grid>


                      <!-- Tier chips sit in the MIDDLE of their own half, the
                           same way the zone's own chip sits in the middle of the
                           whole tile. Pinned to the tile's edges instead, the
                           upper one reads as centered and the lower one as
                           bottom-justified, which is the same arrangement
                           looking lopsided. -->
                      <!-- Decoration only. Every hit inside a half belongs to that
                           half's own button underneath: layering targets over it
                           gave one rectangle two owners that disagreed about
                           both hover and click. -->
                      <Grid RowDefinitions="*,*" ColumnDefinitions="*" Margin="6"
                            IsHitTestVisible="False">
                        <!-- The Viewbox wraps the ROW, not the chip. A horizontal
                             StackPanel measures its children with infinite
                             width, so a Viewbox inside one is never told it has
                             to shrink; out here the width is the tile's. -->
                        <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Stretch"
                                 MaxHeight="20" IsVisible="{Binding HasUpper}"
                                 MaxWidth="{Binding $parent[Button].Bounds.Width,
                                            Converter={x:Static ctl:InsetConverter.Instance},
                                            ConverterParameter=18;64}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="keyChip tierChip"
                                    Classes.hot="{Binding #UpperRegion.IsPointerOver}"
                                    Classes.capturing="{Binding IsUpperCapturing}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Classes="chipModifier" TextWrapping="Wrap"
                                             TextAlignment="Center"
                                             Text="{Binding UpperModifierPrefix}" />
                                  <TextBlock Text="{Binding UpperKey}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="zoneSize"
                                       Classes.hot="{Binding #UpperRegion.IsPointerOver}"
                                       Text="{Binding UpperSize}"
                                       IsVisible="{Binding $parent[Button].Bounds.Width,
                                                   Converter={x:Static ctl:WiderThanConverter.Instance},
                                                   ConverterParameter=170}"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Viewbox>

                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Stretch"
                                 MaxHeight="20" IsVisible="{Binding HasLower}"
                                 MaxWidth="{Binding $parent[Button].Bounds.Width,
                                            Converter={x:Static ctl:InsetConverter.Instance},
                                            ConverterParameter=18;64}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="keyChip tierChip"
                                    Classes.hot="{Binding #LowerRegion.IsPointerOver}"
                                    Classes.capturing="{Binding IsLowerCapturing}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Classes="chipModifier" TextWrapping="Wrap"
                                             TextAlignment="Center"
                                             Text="{Binding LowerModifierPrefix}" />
                                  <TextBlock Text="{Binding LowerKey}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="zoneSize"
                                       Classes.hot="{Binding #LowerRegion.IsPointerOver}"
                                       Text="{Binding LowerSize}"
                                       IsVisible="{Binding $parent[Button].Bounds.Width,
                                                   Converter={x:Static ctl:WiderThanConverter.Instance},
                                                   ConverterParameter=170}"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Viewbox>
                      </Grid>

                      <!-- The zone's own key, on the middle of the whole tile.
                           With tiers present that is the line between the two
                           halves, so it never lands on either tier chip. -->
                      <!-- A Grid, not a StackPanel. A StackPanel arranges its
                           children at the width of its WIDEST child rather than
                           its own, so a chip too big for the tile was handed the
                           space it asked for and the Viewbox was never told to
                           shrink. A Grid arranges to the cell. -->
                      <!-- ColumnDefinitions="*" is load-bearing: an implicit
                           column sizes to its content, so the Viewbox was still
                           handed more width than the tile had. A star column
                           distributes what is actually available. -->
                      <!-- Transparent rather than unset, which makes this band a
                           hit target: the chip, the name and the size are the
                           whole zone stated in the middle of the tile, so
                           pointing at any of them has to mean the whole column.
                           With no background the pointer falls straight through
                           the words to the half behind them, and hovering the
                           zone name lit up a sub-zone instead.

                           Sized to its content by VerticalAlignment, so it
                           claims only the middle band and the halves keep the
                           rest. -->
                      <!-- The middle band, which means the whole column.

                           Two boxes, because what you point at and what you see
                           are not the same shape here: the band spans the tile
                           so the whole middle answers to a click, while the
                           outline inside it hugs the words. Hugging the text
                           with the target itself left the rest of the middle
                           answering to nothing, and a click there did nothing.

                           Transparent rather than unset, or the pointer falls
                           straight through the words to the half behind them. -->
                      <Border Classes="wholeZoneBand"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              PointerEntered="OnWholeEntered"
                              PointerExited="OnHoverLeft">
                        <Border Classes="wholeZoneBlock"
                                HorizontalAlignment="Center"
                                MaxWidth="{Binding $parent[Button].Bounds.Width,
                                           Converter={x:Static ctl:InsetConverter.Instance},
                                           ConverterParameter=10;70}">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*">

                        <!-- Wraps first, shrinks second, and never drops the
                             modifier: a chord without it is not the hotkey it
                             names, and saying which key does what is the
                             diagram's whole job.

                             The cap is on the CHIP rather than the Viewbox. A
                             Viewbox always measures its child unconstrained -
                             that is how it learns the natural size it scales
                             from - so nothing inside one can ever wrap. Capping
                             the chip makes it wrap at the tile's width first,
                             and the Viewbox then shrinks only what is left. A
                             long chord costs height, which a narrow display has
                             plenty of, before it costs legibility.

                             MaxWidth on the chip, not on a container, because
                             neither a StackPanel nor a Grid reliably hands a
                             child less room than it asked for: both arrange it
                             at its own desired width and let it overflow.

                             The same inset caps the VIEWBOX too, floorless. The chip's
                             cap has a floor so a long chord stops shrinking and wraps
                             instead of being clipped - but that floor lets the chip
                             exceed the tile, and the Viewbox then reports the scaled
                             width it needs, which its Grid arranges it at and lets
                             overflow. Capping the Viewbox at the same width the chip
                             is allowed makes the overflow impossible to express: below
                             the floor the scale comes off a width that already has the
                             inset taken out of it. -->
                        <Viewbox Grid.Row="0" x:Name="ChipBox" Stretch="Uniform" StretchDirection="DownOnly"
                                 MaxHeight="{Binding ChipMaxHeight}"
                                 MaxWidth="{Binding $parent[Button].Bounds.Width,
                                            Converter={x:Static ctl:InsetConverter.Instance},
                                            ConverterParameter=18}">
                          <Border Classes="keyChip primaryChip"
                                  MaxWidth="{Binding $parent[Button].Bounds.Width,
                                             Converter={x:Static ctl:InsetConverter.Instance},
                                             ConverterParameter=18;64}">
                            <ItemsControl>
                              <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{x:Static ctl:ChordPartsConverter.Instance}">
                                  <Binding Path="ModifierSegments" />
                                  <Binding Path="KeyLabel" />
                                </MultiBinding>
                              </ItemsControl.ItemsSource>
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <ctl:CenterWrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ctl:ChordPart">
                                  <TextBlock Text="{Binding Text}" TextWrapping="NoWrap"
                                             Classes.chipModifier="{Binding IsModifier}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </Viewbox>

                        <!-- Dropped when the zone is too short to hold it as well
                             as the tier chips at its quarter marks - otherwise
                             they land on each other and neither can be read.
                             How short that is depends on whether there are tiers,
                             hence a threshold from the zone rather than a
                             constant. -->
                        <TextBlock Grid.Row="1" Classes="zoneName" Text="{Binding Name}"
                                   Margin="0,1,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="170">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static ctl:AtLeastConverter.Instance}">
                              <Binding Path="$parent[Button].Bounds.Height" />
                              <Binding Path="NameNeedsHeight" />
                              <Binding ElementName="ChipBox" Path="Bounds.Height" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>

                        <!-- Needs both: room down the zone for another line, and
                             room across it so the bezel does not cut the text
                             mid-word. Still on hover either way. -->
                        <Panel Grid.Row="2">
                          <Panel.IsVisible>
                            <MultiBinding Converter="{x:Static ctl:AtLeastConverter.Instance}">
                              <Binding Path="$parent[Button].Bounds.Height" />
                              <Binding Path="SizeNeedsHeight" />
                              <Binding ElementName="ChipBox" Path="Bounds.Height" />
                            </MultiBinding>
                          </Panel.IsVisible>
                          <TextBlock Classes="zoneSize" Text="{Binding SizeLabel}"
                                     IsVisible="{Binding $parent[Button].Bounds.Width,
                                                 Converter={x:Static ctl:WiderThanConverter.Instance},
                                                 ConverterParameter=95}"
                                     Margin="0,1,0,0"
                                     TextAlignment="Center" />
                            </Panel>
                          </Grid>
                        </Border>
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Seams between this display's zones, laid over the tiles so they
                 can be grabbed. Present only where the diagram was built with a
                 commit callback, which is settings and nowhere else: the wizard
                 and the main window draw the same picture but are not places to
                 reshape it. -->
            <ItemsControl ItemsSource="{Binding Handles}" IsVisible="{Binding HasHandles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ctl:SeamOverlay Orientation="{Binding $parent[ItemsControl].((vm:DisplayNodeViewModel)DataContext).SeamOrientation}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>

              <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                  <Setter Property="ctl:SeamOverlay.Position"
                          Value="{Binding Position, DataType=vm:SplitHandleViewModel}" />
                  <Setter Property="ctl:SeamOverlay.From"
                          Value="{Binding From, DataType=vm:SplitHandleViewModel}" />
                  <Setter Property="ctl:SeamOverlay.To"
                          Value="{Binding To, DataType=vm:SplitHandleViewModel}" />
                </ControlTheme>
              </ItemsControl.ItemContainerTheme>

              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SplitHandleViewModel">
                  <ctl:SplitHandle Classes="seam"
                                   Index="{Binding Index}"
                                   Dragged="{Binding Dragged}"
                                   Released="{Binding Released}"
                                   Orientation="{Binding $parent[ctl:SeamOverlay].Orientation}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </Grid>
          </Border>

        </Panel>

      </DataTemplate>

    </ItemsControl.DataTemplates>
  </ItemsControl>

    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Border Classes="hoverLabel"
              Canvas.Left="{Binding HintX}"
              Canvas.Top="{Binding HintY}"
              IsVisible="{Binding HoverHint, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="body" Text="{Binding HoverHint}" TextWrapping="NoWrap" />
      </Border>
    </Canvas>
  </Panel>

</UserControl>

