<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Mullion.App.Controls"
             xmlns:vm="clr-namespace:Mullion.App.ViewModels"
             x:DataType="vm:ZoneEditorViewModel"
             x:Class="Mullion.App.Controls.ZoneEditor">

  <!-- Two rows, not three. Everything that is not the diagram lives on one
       line above it, because anything below it comes straight out of the
       diagram's own height - and edit mode was shrinking the very picture it
       had just invited you to work on. -->
  <Grid RowDefinitions="Auto,*" MinHeight="240">

    <!-- The controls sit with the picture they change, not on another card or
         another window: Undo a page away from the thing it undoes reads as
         belonging to something else.

         Shown whenever it has anything on it. The settings page is always
         editing and offers no pencil, so keying the whole row off the pencil
         took its Undo away with it. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="CanEdit" />
          <Binding Path="IsEditing" />
        </MultiBinding>
      </Grid.IsVisible>

      <TextBlock Grid.Column="0" Classes="body"
                 VerticalAlignment="Center" Margin="0,0,12,0"
                 TextTrimming="CharacterEllipsis"
                 Text="{Binding Message}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                  VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsEditing}">

          <!-- Up here rather than under the diagram, and terse: the sentence
               explaining it is worth a tooltip, not a permanent two lines of
               the height the diagram wants. -->
          <CheckBox Content="Snap" IsChecked="{Binding SnapSplits}"
                    VerticalAlignment="Center" Margin="0,0,4,0"
                    ToolTip.Tip="Seams settle on a 5% grid, on halves and thirds, and on the positions where a zone comes out at an exact 16:9 or 3:2 for that monitor. Hold Alt while dragging to place one freely." />

          <Button Content="Undo" Command="{Binding UndoCommand}"
                  ToolTip.Tip="Undo the last zone change" />
          <Button Content="Redo" Command="{Binding RedoCommand}"
                  ToolTip.Tip="Redo the zone change just undone" />
          <Button Content="Reset zones" Command="{Binding ResetZonesCommand}"
                  ToolTip.Tip="Discard every custom split and zone count. Keys are left alone." />
          <Button Content="Reset keys" Command="{Binding ResetKeysCommand}"
                  ToolTip.Tip="Put every key back where Mullion would have put it. Zone shapes are left alone." />
        </StackPanel>

        <!-- Furthest right, matching the settings gear it sits under: the same
             kind of control belongs in the same column. The pencil is replaced
             by its own two outcomes rather than sitting beside them, so there
             is never a question of which button ends the session. -->
        <Button Classes="iconButton" Margin="6,0,0,0"
                IsVisible="{Binding ShowEditButton}"
                Command="{Binding BeginEditCommand}"
                ToolTip.Tip="Edit zones">
          <Path Data="{x:Static ctl:Icons.Pencil}" />
        </Button>

        <Button Classes="iconButton confirm" Margin="6,0,0,0"
                IsVisible="{Binding ShowSessionButtons}"
                Command="{Binding ConfirmEditCommand}"
                ToolTip.Tip="Keep these changes">
          <Path Data="{x:Static ctl:Icons.Check}" />
        </Button>

        <Button Classes="iconButton cancel"
                IsVisible="{Binding ShowSessionButtons}"
                Command="{Binding CancelEditCommand}"
                ToolTip.Tip="Discard every change made since you started editing">
          <Path Data="{x:Static ctl:Icons.Cross}" />
        </Button>
      </StackPanel>
    </Grid>

    <ctl:MonitorDiagram Grid.Row="1" DataContext="{Binding Diagram}"
                        ModifierPrefix="{Binding ModifierPrefix}"
                        x:CompileBindings="False" />
  </Grid>
</UserControl>
