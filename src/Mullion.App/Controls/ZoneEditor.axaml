<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Mullion.App.Controls"
             xmlns:vm="clr-namespace:Mullion.App.ViewModels"
             x:DataType="vm:ZoneEditorViewModel"
             x:Class="Mullion.App.Controls.ZoneEditor">

  <!-- Two rows, not three. Everything that is not the diagram lives on one line
       above it, because anything below it comes straight out of the diagram's
       own height - and edit mode was shrinking the very picture it had just
       invited you to work on. -->
  <Grid RowDefinitions="Auto,Auto,*" MinHeight="240">

    <!-- The controls sit with the picture they change, not on another card or
         another window: Undo a page away from the thing it undoes reads as
         belonging to something else.

         Shown whenever it has anything on it. The settings page is always
         editing and offers no pencil, so keying the whole row off the pencil
         took its Undo away with it. -->
    <!-- On its own line, wrapping, and only there when there is something to
         say. Sharing the toolbar row with seven icons left it a sliver, and the
         one message that most needs reading - which keys are allowed - came out
         as "That key is not p... it." Height is only spent while a message is
         up, so the diagram keeps it the rest of the time. -->
    <Border Grid.Row="0" Classes="editorMessage" Margin="0,0,0,6"
            IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Message}" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="CanEdit" />
          <Binding Path="IsEditing" />
        </MultiBinding>
      </Grid.IsVisible>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                  VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" Spacing="2"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsEditing}">

          <!-- The one control here that holds a state rather than doing
               something, so it is the one that lights up. -->
          <Button Classes="iconButton"
                  Classes.active="{Binding SnapSplits}"
                  Command="{Binding ToggleSnapCommand}"
                  ToolTip.Tip="Snap while dragging. Seams settle on a 5% grid, on halves and thirds, and on the positions where a zone comes out at an exact 16:9 or 3:2 for that monitor. Hold Alt while dragging to place one freely.">
            <Path Data="{x:Static ctl:Icons.Snap}" />
          </Button>

          <Button Classes="iconButton" Command="{Binding UndoCommand}"
                  ToolTip.Tip="Undo the last zone change">
            <Path Data="{x:Static ctl:Icons.Undo}" />
          </Button>

          <Button Classes="iconButton" Command="{Binding RedoCommand}"
                  ToolTip.Tip="Redo the zone change just undone">
            <Path Data="{x:Static ctl:Icons.Redo}" />
          </Button>

          <!-- The two resets, each showing what it acts on with a reset arrow
               worked into it. They throw away work and pressing them again does
               not bring it back, so the tooltips say plainly what goes and what
               is left alone. -->
          <Button Classes="iconButton" Margin="6,0,0,0"
                  Command="{Binding ResetZonesCommand}"
                  ToolTip.Tip="Reset zones to defaults. Discards every custom split and zone count; keys are left alone.">
            <Path Data="{x:Static ctl:Icons.ResetZones}" />
          </Button>

          <Button Classes="iconButton"
                  Command="{Binding ResetKeysCommand}"
                  ToolTip.Tip="Reset keys to defaults. Puts every key back where Mullion would have put it; zone shapes are left alone.">
            <Path Data="{x:Static ctl:Icons.ResetKeys}" />
          </Button>
        </StackPanel>

        <!-- Furthest right, matching the settings gear it sits under: the same
             kind of control belongs in the same column. The pencil is replaced
             by its own two outcomes rather than sitting beside them, so there is
             never a question of which button ends the session. -->
        <Button Classes="iconButton" Margin="6,0,0,0"
                IsVisible="{Binding ShowEditButton}"
                Command="{Binding BeginEditCommand}"
                ToolTip.Tip="Edit zones">
          <Path Data="{x:Static ctl:Icons.Pencil}" />
        </Button>

        <Button Classes="iconButton" Margin="6,0,0,0"
                IsVisible="{Binding ShowSessionButtons}"
                Command="{Binding ConfirmEditCommand}"
                ToolTip.Tip="Keep these changes">
          <Path Data="{x:Static ctl:Icons.Check}" />
        </Button>

        <Button Classes="iconButton"
                IsVisible="{Binding ShowSessionButtons}"
                Command="{Binding CancelEditCommand}"
                ToolTip.Tip="Discard every change made since you started editing">
          <Path Data="{x:Static ctl:Icons.Cross}" />
        </Button>
      </StackPanel>
    </Grid>

    <ctl:MonitorDiagram Grid.Row="2" DataContext="{Binding Diagram}"
                        ModifierPrefix="{Binding ModifierPrefix}"
                        x:CompileBindings="False" />
  </Grid>
</UserControl>
