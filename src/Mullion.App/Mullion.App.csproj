<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Mullion.App</RootNamespace>
    <AssemblyName>Mullion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Embeds the icon into the executable's Win32 resources. This is what
         Explorer, the taskbar and Alt+Tab read; Window.Icon only affects the
         window at runtime, so without this the .exe shows a generic icon in
         Explorer no matter how fresh the build. -->
    <ApplicationIcon>Assets\mullion.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- Workstation concurrent GC: a blocking gen2 collection is the most
         likely cause of a hook callback overrunning LowLevelHooksTimeout. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- Symbols go INSIDE the assembly rather than beside it, so a published
         build is a single file that still produces stack traces with line
         numbers. Losing those in exchange for a tidy folder would be a bad
         trade for a background app that fails while nobody is watching. -->
    <DebugType>embedded</DebugType>

    <!-- Publishing
         One self-contained file, so installing Mullion is copying an exe and
         running it: no SDK, no runtime, nothing to keep in step. A background
         app that needs a framework installed first is one people give up on
         before they find out whether they like it.

         Native libraries are extracted rather than left beside the exe -
         Avalonia's rendering is native code, and without this the "single file"
         arrives with a folder of DLLs it cannot start without.

         Deliberately NOT trimmed. Avalonia resolves controls, converters and
         styles by name at runtime, so a trimmer that cannot see those uses
         removes them and the failure is a blank window at launch rather than a
         build error. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Compressed, which costs nothing worth having: measured on this machine
         it takes the exe from 144MB to 63MB and the window still appears in
         under a second. Ahead-of-time compilation stays on despite roughly
         doubling the compressed size, because the alternative saves 15MB and
         adds noticeably to a start that happens at every sign-in. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

  </PropertyGroup>

  <!--
    Strip .pdb files from publish output. Ours are embedded by the property
    above, and the rest are not ours at all: Avalonia's native renderer ships
    libSkiaSharp.pdb (82 MB) and libHarfBuzzSharp.pdb (20 MB), which roughly
    double the published size and are of no use without Skia's own sources.
    DebugType alone does not remove those, because they arrive as package
    runtime assets rather than as build output.
  -->
  <Target Name="RemovePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!--
    No Avalonia.Diagnostics: it was discontinued at 11.3.20 and has no 12.x
    release, DevTools having moved into the core package.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Mullion.Core\Mullion.Core.csproj" />
  </ItemGroup>

  <!-- Referenced only on Windows so the app project itself stays platform
       neutral and a macOS backend can drop in without TFM surgery. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\Mullion.Platform.Windows\Mullion.Platform.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
  </PropertyGroup>

</Project>
