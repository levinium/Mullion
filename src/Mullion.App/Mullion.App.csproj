<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Mullion.App</RootNamespace>
    <AssemblyName>Mullion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Embeds the icon into the executable's Win32 resources. This is what
         Explorer, the taskbar and Alt+Tab read; Window.Icon only affects the
         window at runtime, so without this the .exe shows a generic icon in
         Explorer no matter how fresh the build. -->
    <ApplicationIcon>Assets\mullion.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- Workstation concurrent GC: a blocking gen2 collection is the most
         likely cause of a hook callback overrunning LowLevelHooksTimeout. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- Symbols go INSIDE the assembly rather than beside it, so a published
         build is a single file that still produces stack traces with line
         numbers. Losing those in exchange for a tidy folder would be a bad
         trade for a background app that fails while nobody is watching. -->
    <DebugType>embedded</DebugType>

    <!-- Publishing
         One self-contained file, so installing Mullion is copying an exe and
         running it: no SDK, no runtime, nothing to keep in step. A background
         app that needs a framework installed first is one people give up on
         before they find out whether they like it.

         Native libraries are extracted rather than left beside the exe -
         Avalonia's rendering is native code, and without this the "single file"
         arrives with a folder of DLLs it cannot start without.

         Deliberately NOT trimmed. Avalonia resolves controls, converters and
         styles by name at runtime, so a trimmer that cannot see those uses
         removes them and the failure is a blank window at launch rather than a
         build error. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Compressed, which costs nothing worth having: measured on this machine
         it takes the exe from 144MB to 63MB and the window still appears in
         under a second. Ahead-of-time compilation stays on despite roughly
         doubling the compressed size, because the alternative saves 15MB and
         adds noticeably to a start that happens at every sign-in. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

  </PropertyGroup>

  <!--
    Strip .pdb files from publish output. Ours are embedded by the property
    above, and the rest are not ours at all: Avalonia's native renderer ships
    libSkiaSharp.pdb (82 MB) and libHarfBuzzSharp.pdb (20 MB), which roughly
    double the published size and are of no use without Skia's own sources.
    DebugType alone does not remove those, because they arrive as package
    runtime assets rather than as build output.
  -->
  <Target Name="RemovePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!--
    Where the "Support Mullion" button goes, and the reason it is a build
    property rather than a constant in the source.

    This repository is meant to be published. A funding handle is not a secret -
    it exists to be given out - but it identifies a person, and a fork built
    from source must not quietly solicit donations to whoever wrote the code.
    Left empty, as it is here, the app has no donate button at all: nothing to
    strip out of a fork, and nothing to remember to remove.

    Set it only when publishing a release:

      .\tools\Publish.ps1 -SponsorUrl "https://github.com/sponsors/<user>"

    An {amount} placeholder, if the destination understands one, turns the ask
    into a picker; without it the ask is a single button. See SponsorLink.
  -->
  <PropertyGroup>
    <SponsorUrl></SponsorUrl>
  </PropertyGroup>

  <ItemGroup Condition="'$(SponsorUrl)' != ''">
    <AssemblyMetadata Include="SponsorUrl" Value="$(SponsorUrl)" />
  </ItemGroup>

  <!--
    Where the app looks to see whether a newer release exists.

    Unlike SponsorUrl this DOES have a default, because the two properties are
    solving opposite problems. A donate link left in by accident asks strangers
    for money on the author's behalf, so it defaults to off. An update feed left
    out by accident is silent in the other direction: the app simply never
    mentions a release again, and nobody reports a notification that did not
    arrive. Defaulting it on is the failure that gets noticed.

    A fork should point this at its own releases or blank it, which is a one
    line change either way:

      <UpdateFeedUrl></UpdateFeedUrl>
  -->
  <PropertyGroup>
    <UpdateFeedUrl Condition="'$(UpdateFeedUrl)' == ''">https://api.github.com/repos/levinium/Mullion/releases/latest</UpdateFeedUrl>
    <UpdatePageUrl Condition="'$(UpdatePageUrl)' == ''">https://github.com/levinium/Mullion/releases/latest</UpdatePageUrl>
  </PropertyGroup>

  <ItemGroup Condition="'$(UpdateFeedUrl)' != ''">
    <AssemblyMetadata Include="UpdateFeedUrl" Value="$(UpdateFeedUrl)" />
    <AssemblyMetadata Include="UpdatePageUrl" Value="$(UpdatePageUrl)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!--
    No Avalonia.Diagnostics: it was discontinued at 11.3.20 and has no 12.x
    release, DevTools having moved into the core package.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Mullion.Core\Mullion.Core.csproj" />
  </ItemGroup>

  <!-- Referenced only on Windows so the app project itself stays platform
       neutral and a macOS backend can drop in without TFM surgery. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\Mullion.Platform.Windows\Mullion.Platform.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
  </PropertyGroup>

</Project>
