<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mullion.App.App"
             RequestedThemeVariant="Default">

  <!-- The tray icon is created in code, not declared here: a XAML-declared
       TrayIcon that fails to construct simply does not appear, with no error,
       and the app is then left with no way to quit. See TrayController. -->

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Mullion/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
