<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain net10.0, NOT net10.0-windows: raw P/Invoke needs no Windows-specific
    TFM (only WinForms/WPF/CsWinRT do). Keeping it neutral means Mullion.App can
    stay platform-agnostic and a macOS backend drops in with no TFM surgery.
    SupportedOSPlatform gives the analyzers what they need instead.
  -->
  <PropertyGroup>
    <RootNamespace>Mullion.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mullion.Core\Mullion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
